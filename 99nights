-- ── Game modules + remotes ───────────────────────────────────────────────────
-- Every remote sits in ReplicatedStorage.RemoteEvents. The game's own client modules come from
-- PlayerScripts.Client (a lazy loader: indexing it requires the module).
local G = {}
do
    local function try(fn) local ok, v = pcall(fn); if ok then return v end return nil end
    G.try = try
    local client
    function G.client()
        if client then return client end
        local ps = LP:FindFirstChild("PlayerScripts")
        local m = ps and ps:FindFirstChild("Client")
        client = m and try(function() return require(m) end) or nil
        return client
    end
    function G.mod(name)
        local c = G.client()
        return c and try(function() return c[name] end)
    end
    local remotes = RS:WaitForChild("RemoteEvents", 20)
    function G.remote(name) return remotes and remotes:FindFirstChild(name) end
    function G.fire(name, ...)
        local r = G.remote(name)
        if not (r and r:IsA("RemoteEvent")) then return false end
        return (pcall(r.FireServer, r, ...))
    end
    function G.invoke(name, ...)
        local r = G.remote(name)
        if not (r and r:IsA("RemoteFunction")) then return nil end
        local ok, res = pcall(r.InvokeServer, r, ...)
        return ok and res or nil
    end
    function G.ok(res) return res == true or (type(res) == "table" and res.Success == true) end

    -- "<n>_<userId>": the game's own counter when it's reachable, so ids never collide with its swings
    local hitN = math.random(40000, 90000)
    function G.hitId()
        local eh = G.mod("EnemyHandler")
        local id = eh and eh.GetHitRegId and try(eh.GetHitRegId)
        if type(id) == "string" then return id end
        hitN += 1
        return hitN .. "_" .. math.abs(LP.UserId)
    end

    -- ── inventory / tools ──
    function G.inv() return LP:FindFirstChild("Inventory") end
    function G.invItems()
        local inv = G.inv()
        return inv and inv:GetChildren() or {}
    end
    function G.has(name)
        local inv = G.inv()
        return inv ~= nil and inv:FindFirstChild(name) ~= nil
    end
    function G.equipped()
        local ih = G.mod("InventoryHandler")
        return ih and try(ih.GetCurrentlyEquipped) or nil
    end
    function G.equip(item)
        if not item or item.Parent ~= G.inv() then return false end
        if G.equipped() == item then return true end
        local ih = G.mod("InventoryHandler")
        if ih and ih.RequestEquipItem and pcall(ih.RequestEquipItem, item) then
            return G.equipped() == item
        end
        return G.fire("EquipItemHandle", "FireAllClients", item)
    end
    function G.bag()
        for _, it in G.invItems() do
            if it:HasTag("ItemBag") then return it end
        end
        return nil
    end

    -- ── world ──
    function G.map() return workspace:FindFirstChild("Map") end
    function G.camp()
        local m = G.map()
        return m and m:FindFirstChild("Campground")
    end
    function G.mainFire()
        local c = G.camp()
        return c and c:FindFirstChild("MainFire")
    end
    function G.firePos()
        local f = G.mainFire()
        if not f then return Vector3.new(0, 10, 0) end
        local z = f:FindFirstChild("InnerTouchZone")
        if z and z:IsA("BasePart") then return z.Position end
        return (f.PrimaryPart and f.PrimaryPart.Position) or f:GetPivot().Position
    end
    function G.fuel()
        local f = G.mainFire()
        if not f then return 0, 1 end
        local left = tonumber(f:GetAttribute("FuelRemaining")) or 0
        local target = tonumber(f:GetAttribute("FuelTarget")) or 0
        return left, target > 0 and target or math.max(left, 1)
    end
    function G.scrapper()
        local c = G.camp()
        local s = c and c:FindFirstChild("Scrapper")
        if not s then
            for _, m in CS:GetTagged("CraftingBench") do
                if m:IsDescendantOf(workspace) then s = m; break end
            end
        end
        return s
    end
    function G.scrapPos()
        local s = G.scrapper()
        if not s then return nil end
        local z = s:FindFirstChild("TouchZone", true)
        if z and z:IsA("BasePart") then return z.Position end
        return s:GetPivot().Position
    end
    function G.benchPos()
        local c = G.camp()
        local b = c and c:FindFirstChild("CraftingBench")
        return b and b:GetPivot().Position
    end
    function G.items()
        local f = workspace:FindFirstChild("Items")
        return f and f:GetChildren() or {}
    end
    function G.characters()
        local f = workspace:FindFirstChild("Characters")
        return f and f:GetChildren() or {}
    end

    -- ── survival stats / day cycle ──
    function G.hunger()
        local h = tonumber(LP:GetAttribute("Hunger")) or 0
        local max = (LP:GetAttribute("Class") == "Feaster") and 300 or 200
        return h, math.max(max, h)
    end
    function G.temperature() return tonumber(LP:GetAttribute("Temperature")) or 100 end
    function G.isNight() return workspace:GetAttribute("State") == "Night" end
    function G.day() return tonumber(workspace:GetAttribute("StoryDayCounter")) or tonumber(workspace:GetAttribute("RealDayCounter")) or 0 end
    function G.secondsLeft() return tonumber(workspace:GetAttribute("SecondsLeft")) or 0 end
    function G.fireLevel() return tonumber(workspace:GetAttribute("Progress")) or 1 end

    -- the forest wall: a circle around the campfire (world origin) of radius MapRange,
    -- pushed out every time the campfire levels up
    function G.mapRange()
        if RS:GetAttribute("UnlockMap") then return math.huge end
        return tonumber(workspace:GetAttribute("MapRange")) or math.huge
    end
    function G.inBounds(pos, margin)
        if not pos then return false end
        return Vector3.new(pos.X, 0, pos.Z).Magnitude <= G.mapRange() - (margin or 10)
    end

    -- ── items ──
    -- other players' items (Owner set to someone else) can't be dragged or used
    function G.mine(item)
        local o = item:GetAttribute("Owner")
        return o == nil or o == LP.UserId
    end
    function G.root(item)
        if item:IsA("BasePart") then return item end
        return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true)
    end
    function G.itemPos(item)
        local r = G.root(item)
        return r and r.Position
    end
    -- moves an item the way the game's own drag does: claim it, pivot it, let go
    function G.drag(item, cf, hold)
        if not (item and item.Parent and G.root(item)) then return false end
        G.fire("RequestStartDraggingItem", item)
        task.wait(0.05)
        pcall(function()
            item:PivotTo(cf)
            local r = G.root(item)
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
        task.delay(hold or 0.35, function()
            if item.Parent then G.fire("StopDraggingItem", item) end
        end)
        return true
    end

    function G.prompt(p)
        if not (p and p:IsA("ProximityPrompt")) then return false end
        if fireproximityprompt then return (pcall(fireproximityprompt, p)) end
        return (pcall(function()
            p:InputHoldBegin(); task.wait((p.HoldDuration or 0) + 0.05); p:InputHoldEnd()
        end))
    end
end

-- ── Utils ────────────────────────────────────────────────────────────────────
local U = {}
do
    function U.char() return LP.Character end
    function U.hrp(m) m = m or LP.Character; return m and m:FindFirstChild("HumanoidRootPart") end
    function U.hum(m)
        m = m or LP.Character
        if not m then return nil end
        return m:FindFirstChildOfClass("Humanoid")
    end
    function U.alive(m)
        local h = U.hum(m)
        return h ~= nil and h.Health > 0 and U.hrp(m) ~= nil
    end
    function U.ping()
        local ok, v = pcall(function() return StatsSvc.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if ok and type(v) == "number" and v > 0 then return v / 1000 end
        local ok2, p = pcall(function() return LP:GetNetworkPing() end)
        return (ok2 and p or 0.05) * 2
    end
    function U.humanoidsFolder() return workspace:FindFirstChild("Characters") end
    function U.mobFolders()
        local f = workspace:FindFirstChild("Characters")
        return f and { f } or {}
    end
    function U.isPlayerModel(m) return Players:GetPlayerFromCharacter(m) ~= nil end
    function U.posOf(inst)
        if not inst then return nil end
        if inst:IsA("ProximityPrompt") then inst = inst.Parent end
        if not inst then return nil end
        if inst:IsA("Attachment") then return inst.WorldPosition end
        if inst:IsA("BasePart") then return inst.Position end
        if inst:IsA("Model") then
            local ok, cf = pcall(inst.GetPivot, inst)
            if ok then return cf.Position end
        end
        local p = inst:FindFirstChildWhichIsA("BasePart", true)
        return p and p.Position
    end
    function U.dist(pos)
        local me = U.hrp()
        return (me and pos) and (pos - me.Position).Magnitude or math.huge
    end
    function U.overOurGui()
        local gui = PlayerGui:FindFirstChild("ZenithImmortalUI")
        if not gui then return false end
        local m = UIS:GetMouseLocation()
        for _, o in gui:GetChildren() do
            if (o.Name == "Main" or o:IsA("ImageButton")) and o.Visible then
                local p, s = o.AbsolutePosition, o.AbsoluteSize
                if m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y then return true end
            end
        end
        return false
    end
    function U.face(pos)
        local hrp = U.hrp()
        if not (hrp and pos) then return end
        local p = hrp.Position
        local flat = Vector3.new(pos.X, p.Y, pos.Z)
        if (flat - p).Magnitude > 0.2 then hrp.CFrame = CFrame.lookAt(p, flat) end
    end
    -- instant hop (used for short repositioning: chests, kids, items)
    function U.tp(pos, up)
        local hrp = U.hrp()
        if not (hrp and pos) then return false end
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, up or 3, 0)) * hrp.CFrame.Rotation
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true
    end
end

-- ── NPCs (mobs, animals, kids) ───────────────────────────────────────────────
-- Mobs are Models in workspace.Characters tagged "NPC"; their Humanoid is named "NPC".
-- Lost kids are tagged "ChildNPC".
local Npc = {}
do
    local PASSIVE = { Bunny = true, Chick = true, Kiwi = true, ["Arctic Fox"] = false }
    function Npc.hum(m) return m and (m:FindFirstChild("NPC") or m:FindFirstChildOfClass("Humanoid")) end
    function Npc.root(m) return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart) end
    function Npc.isKid(m) return m:HasTag("ChildNPC") or m:GetAttribute("KidId") ~= nil end
    function Npc.valid(m)
        if not (m and m.Parent and m:IsA("Model")) then return false end
        local h = Npc.hum(m)
        return h ~= nil and h.Health > 0 and Npc.root(m) ~= nil
    end
    function Npc.passive(m) return PASSIVE[m.Name] == true end
    function Npc.isCultist(m) return m.Name:find("Cultist") ~= nil or m:GetAttribute("RangedUnit") == true end
    -- something Kill Aura may hit
    function Npc.attackable(m)
        if not Npc.valid(m) or Npc.isKid(m) then return false end
        if not m:HasTag("NPC") then return false end
        if m:GetAttribute("Dead") or m:GetAttribute("NotAttackable") or m:GetAttribute("NotDamageable") then return false end
        if m:GetAttribute("Tamed") and m.Name ~= "Chick" then return false end
        if m:GetAttribute("OwnerId") ~= nil then return false end
        return true
    end
    function Npc.list()
        local out = {}
        for _, m in G.characters() do
            if m:IsA("Model") and Npc.valid(m) and not Npc.isKid(m) then out[#out + 1] = m end
        end
        return out
    end
    function Npc.kids()
        local out = {}
        for _, m in CS:GetTagged("ChildNPC") do
            if m:IsDescendantOf(workspace) then out[#out + 1] = m end
        end
        return out
    end
    function Npc.kidName(m)
        local id = m:GetAttribute("KidId")
        if type(id) == "string" then return (id:gsub("(%l)(%u)", "%1 %2")) end
        return m.Name
    end
    function Npc.names()
        local seen, out = {}, {}
        for _, m in Npc.list() do
            if not seen[m.Name] then seen[m.Name] = true; out[#out + 1] = m.Name end
        end
        table.sort(out)
        return out
    end
end

-- ── Input (VirtualInputManager, executor keypress as fallback) ───────────────
local Input = { held = {}, mouseHeld = false }
do
    local VIM = (function()
        local ok, v = pcall(function() return game:GetService("VirtualInputManager") end)
        return ok and v or nil
    end)()
    local NUM = { Zero = 0x30, One = 0x31, Two = 0x32, Three = 0x33, Four = 0x34,
                  Five = 0x35, Six = 0x36, Seven = 0x37, Eight = 0x38, Nine = 0x39 }
    local SPECIAL = { Space = 0x20, Tab = 0x09, LeftShift = 0xA0, RightShift = 0xA1,
                      LeftControl = 0xA2, LeftAlt = 0xA4, CapsLock = 0x14 }
    function Input.vk(kc)
        local n = kc and kc.Name or ""
        if #n == 1 then return string.byte(n) end
        return NUM[n] or SPECIAL[n]
    end
    local function vimKey(down, kc)
        return VIM ~= nil and pcall(VIM.SendKeyEvent, VIM, down, kc, false, game)
    end
    local function vimMouse(down)
        if not VIM then return false end
        local m = UIS:GetMouseLocation()
        return pcall(VIM.SendMouseButtonEvent, VIM, m.X, m.Y, 0, down, game, 0)
    end

    function Input.down(kc)
        if typeof(kc) ~= "EnumItem" then return end
        if vimKey(true, kc) then Input.held[kc] = "vim"; return end
        local vk, f = Input.vk(kc), keypress or keydown
        if vk and f then pcall(f, vk); Input.held[kc] = vk end
    end
    function Input.up(kc)
        if typeof(kc) ~= "EnumItem" then return end
        local how = Input.held[kc]
        Input.held[kc] = nil
        if how ~= nil and how ~= "vim" then
            local f = keyrelease or keyup
            if f then pcall(f, how) end
            return
        end
        if not vimKey(false, kc) then
            local vk, f = Input.vk(kc), keyrelease or keyup
            if vk and f then pcall(f, vk) end
        end
    end
    function Input.mouseDown()
        if Input.mouseHeld then return end
        if vimMouse(true) then Input.mouseHeld = "vim"; return end
        if mouse1press then pcall(mouse1press); Input.mouseHeld = true end
    end
    function Input.mouseUp()
        if not Input.mouseHeld then return end
        local how = Input.mouseHeld
        Input.mouseHeld = false
        if how == "vim" and vimMouse(false) then return end
        if mouse1release then pcall(mouse1release) end
    end
    function Input.click()
        if vimMouse(true) then task.wait(0.03); vimMouse(false); return end
        if mouse1click then pcall(mouse1click) end
    end
    function Input.releaseAll()
        for kc in table.clone(Input.held) do Input.up(kc) end
        table.clear(Input.held)
        Input.mouseUp()
    end
end


-- ── Items (workspace.Items) ──────────────────────────────────────────────────
-- Sorted by the attributes the game itself checks: BurnFuel (campfire), RestoreHunger (food),
-- Cookable (raw), RestoreHealth (healing), Scrappable / CanBeGrinded (scrapper).
local Items = { picked = {} }
do
    Items.KINDS = { "Logs", "Fuel", "Food", "Raw Meat", "Cooked Food", "Healing", "Scrap", "Gems", "Cultist Gems", "Weapons & Armour",
                    "Ammo", "Saplings", "Selected Items", "Everything" }
    function Items.isChest(it) return it:HasTag("Chest") or it:GetAttribute("Interaction") == "ItemChest" end
    function Items.usable(it)
        if not (it:IsA("Model") or it:IsA("BasePart")) then return false end
        if Items.isChest(it) or it:GetAttribute("Destroyed") or it:GetAttribute("Ignited") or it:GetAttribute("Locked") then return false end
        return G.mine(it) and G.root(it) ~= nil
    end
    function Items.isLog(it) return it.Name == "Log" or it.Name == "Super Log" end
    function Items.isFuel(it) return (tonumber(it:GetAttribute("BurnFuel")) or 0) > 0 and (tonumber(it:GetAttribute("Wet")) or 0) < 1 end
    function Items.isFood(it) return it:GetAttribute("RestoreHunger") ~= nil end
    function Items.isRaw(it) return it:GetAttribute("Cookable") ~= nil end
    function Items.isHealing(it) return it:GetAttribute("RestoreHealth") ~= nil end
    function Items.isScrap(it) return it:GetAttribute("Scrappable") ~= nil or it:HasTag("CanBeGrinded") end
    function Items.isGem(it) return it:HasTag("Gem") or it:HasTag("GreenGem") or it:GetAttribute("Diamonds") ~= nil end
    function Items.isGear(it)
        local i = it:GetAttribute("Interaction")
        return i == "Tool" or i == "Armour"
    end
    function Items.isAmmo(it) return it.Name:find("Ammo") ~= nil end
    function Items.isSapling(it) return it:HasTag("Plantable") end

    function Items.match(it, kind)
        if kind == "Logs" then return Items.isLog(it)
        elseif kind == "Fuel" then return Items.isFuel(it)
        elseif kind == "Food" then return Items.isFood(it)
        elseif kind == "Raw Meat" then return Items.isRaw(it)
        elseif kind == "Cooked Food" then return Items.isFood(it) and not Items.isRaw(it)
        elseif kind == "Healing" then return Items.isHealing(it)
        elseif kind == "Scrap" then return Items.isScrap(it)
        elseif kind == "Gems" then return Items.isGem(it)
        elseif kind == "Weapons & Armour" then return Items.isGear(it)
        elseif kind == "Ammo" then return Items.isAmmo(it)
        elseif kind == "Saplings" then return Items.isSapling(it)
        elseif kind == "Cultist Gems" then return (it:HasTag("Gem") or it:HasTag("GreenGem")) and it:GetAttribute("Diamonds") == nil
        elseif kind == "Selected Items" then return Items.picked[it.Name] == true
        elseif kind == "Everything" then return true end
        return false
    end
    -- matching items nearest first, within range of `from`
    function Items.find(kind, range, from, max)
        from = from or (U.hrp() and U.hrp().Position)
        if not from then return {} end
        local out = {}
        for _, it in G.items() do
            if Items.usable(it) and Items.match(it, kind) then
                local p = G.itemPos(it)
                local d = p and (p - from).Magnitude
                if d and d <= range then out[#out + 1] = { it = it, d = d } end
            end
        end
        table.sort(out, function(a, b) return a.d < b.d end)
        local list = {}
        for i = 1, math.min(#out, max or #out) do list[i] = out[i].it end
        return list
    end
    function Items.names()
        local seen, out = {}, {}
        for _, it in G.items() do
            if Items.usable(it) and not seen[it.Name] then seen[it.Name] = true; out[#out + 1] = it.Name end
        end
        table.sort(out)
        return out
    end

    -- chests (tagged "Chest"); opened per player
    function Items.chestOpened(c)
        return c:GetAttribute("LocalOpened") == true or c:GetAttribute(math.abs(LP.UserId) .. "Opened") == true
            or c:GetAttribute("ChestEmpty") == true or c:HasTag("PreOpenedChest")
    end
    function Items.chests(includeOpened)
        local out = {}
        for _, c in CS:GetTagged("Chest") do
            if c:IsDescendantOf(workspace) and (includeOpened or not Items.chestOpened(c)) then out[#out + 1] = c end
        end
        return out
    end
end

-- ── ESP ──────────────────────────────────────────────────────────────────────
local Esp = { combat = {}, world = {} }
do
    local function container()
        if typeof(gethui) == "function" then
            local ok, h = pcall(gethui)
            if ok and h then return h end
        end
        local ok, cg = pcall(function() return game:GetService("CoreGui") end)
        if ok and cg then
            local test = Instance.new("Folder")
            if pcall(function() test.Parent = cg end) then test:Destroy(); return cg end
            test:Destroy()
        end
        return PlayerGui
    end
    Esp.root = Instance.new("Folder")
    Esp.root.Name = "Zenith99Esp"
    Esp.root.Parent = container()

    local COL = {
        player = Color3.fromRGB(120, 180, 255), mob = Color3.fromRGB(255, 95, 95), animal = Color3.fromRGB(235, 235, 235),
        kid = Color3.fromRGB(120, 255, 160), chest = Color3.fromRGB(255, 170, 60), fuel = Color3.fromRGB(255, 120, 40),
        food = Color3.fromRGB(255, 220, 100), scrap = Color3.fromRGB(180, 190, 205), gear = Color3.fromRGB(200, 150, 255),
        trader = Color3.fromRGB(110, 210, 255),
    }

    local function billboard(adornee, h)
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.fromOffset(200, h or 44)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = adornee
        bb.Parent = Esp.root
        local l = Instance.new("TextLabel")
        l.Size = UDim2.fromScale(1, 1)
        l.BackgroundTransparency = 1
        l.Font = Enum.Font.GothamBold
        l.TextSize = 12
        l.RichText = true
        l.TextStrokeTransparency = 0.35
        l.TextColor3 = Color3.new(1, 1, 1)
        l.Parent = bb
        return bb, l
    end
    local function hex(c) return string.format("#%02X%02X%02X", c.R * 255, c.G * 255, c.B * 255) end

    function Esp.stepCombat()
        local me = U.hrp()
        local seen = {}
        if me then
            local list = {}
            if Cfg.espMobs then for _, m in Npc.list() do list[#list + 1] = { m = m, kind = Npc.passive(m) and "animal" or "mob" } end end
            if Cfg.espKids then for _, m in Npc.kids() do list[#list + 1] = { m = m, kind = "kid" } end end
            if Cfg.espPlayers then
                for _, p in Players:GetPlayers() do
                    if p ~= LP and p.Character then list[#list + 1] = { m = p.Character, kind = "player", p = p } end
                end
            end
            for _, e in list do
                local m = e.m
                local root = Npc.root(m)
                local hum = Npc.hum(m)
                if root then
                    local dist = (root.Position - me.Position).Magnitude
                    if dist <= Cfg.espRange then
                        seen[m] = true
                        local it = Esp.combat[m]
                        if not it or not it.bb.Parent then
                            local bb, l = billboard(m:FindFirstChild("Head") or root, 44)
                            it = { bb = bb, l = l }; Esp.combat[m] = it
                        end
                        local name = (e.kind == "player" and (Cfg.streamer and "Player" or e.p.Name))
                            or (e.kind == "kid" and Npc.kidName(m)) or m.Name
                        local lines = { string.format('<font color="%s">%s</font> <font color="#9AA0C0">[%dm]</font>',
                            hex(COL[e.kind]), name, math.floor(dist)) }
                        if Cfg.espHealth and hum and e.kind ~= "kid" then
                            lines[2] = string.format("HP %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                        elseif e.kind == "kid" then
                            lines[2] = m:GetAttribute("Rescued") and "Rescued" or "Lost"
                        end
                        it.l.Text = table.concat(lines, "\n")
                    end
                end
            end
        end
        for m, it in Esp.combat do
            if not seen[m] then it.bb:Destroy(); Esp.combat[m] = nil end
        end
    end

    local TRADER_TAGS = { "PeltTrader", "StrangeTrader", "ToolTrader", "AlienTrader" }
    local function worldList()
        local out = {}
        if Cfg.espChests then
            for _, c in Items.chests(false) do out[#out + 1] = { inst = c, col = "chest", text = c.Name } end
        end
        if Cfg.espFuel or Cfg.espFood or Cfg.espScrap or Cfg.espGear then
            for _, it in G.items() do
                if Items.usable(it) then
                    local col = (Cfg.espFuel and Items.isFuel(it) and "fuel") or (Cfg.espFood and Items.isFood(it) and "food")
                        or (Cfg.espScrap and Items.isScrap(it) and "scrap") or (Cfg.espGear and Items.isGear(it) and "gear")
                    if col then out[#out + 1] = { inst = it, col = col, text = it.Name } end
                end
            end
        end
        if Cfg.espTraders then
            for _, tag in TRADER_TAGS do
                for _, t in CS:GetTagged(tag) do
                    if t:IsDescendantOf(workspace) then out[#out + 1] = { inst = t, col = "trader", text = (tag:gsub("(%l)(%u)", "%1 %2")) } end
                end
            end
        end
        return out
    end

    function Esp.stepWorld()
        local me = U.hrp()
        local seen = {}
        if me then
            for _, w in worldList() do
                local inst = w.inst
                local a = G.root(inst)
                if a then
                    local dist = (a.Position - me.Position).Magnitude
                    if dist <= Cfg.espRange then
                        seen[inst] = true
                        local it = Esp.world[inst]
                        if not it or not it.bb.Parent then
                            local bb, l = billboard(a, 26)
                            bb.StudsOffset = Vector3.new(0, 1.5, 0)
                            l.TextColor3 = COL[w.col]
                            l.TextSize = 11
                            it = { bb = bb, l = l }; Esp.world[inst] = it
                        end
                        it.l.Text = string.format("%s [%dm]", w.text, math.floor(dist))
                    end
                end
            end
        end
        for inst, it in Esp.world do
            if not seen[inst] then it.bb:Destroy(); Esp.world[inst] = nil end
        end
    end

    function Esp.shutdown()
        pcall(function() Esp.root:Destroy() end)
        table.clear(Esp.combat); table.clear(Esp.world)
    end
end

-- ── Performance (FPS saver) ──────────────────────────────────────────────────
local Perf = {
    solidColor = false, color = Color3.fromRGB(120, 120, 120),
    noEffects = false, noShadows = false, lowLighting = false, lowQuality = false,
}
do
    local saved    = setmetatable({}, { __mode = "k" })
    local detached = {}
    local queue    = {}
    local addConn, queueConn
    local scanToken = 0
    local EFFECTS = { ParticleEmitter = true, Trail = true, Beam = true, Smoke = true, Fire = true, Sparkles = true }
    local POSTFX  = { BloomEffect = true, BlurEffect = true, SunRaysEffect = true, ColorCorrectionEffect = true, DepthOfFieldEffect = true }

    local function set(inst, prop, value)
        local s = saved[inst]
        if not s then s = {}; saved[inst] = s end
        if s[prop] == nil then
            local ok, v = pcall(function() return inst[prop] end)
            if not ok then return end
            s[prop] = v
        end
        pcall(function() inst[prop] = value end)
    end

    local function excluded(inst)
        local f = U.humanoidsFolder()
        if f and inst:IsDescendantOf(f) then return true end
        local c = LP.Character
        if c and inst:IsDescendantOf(c) then return true end
        for _, name in { "Items", "Characters" } do
            local folder = workspace:FindFirstChild(name)
            if folder and inst:IsDescendantOf(folder) then return true end
        end
        return false
    end

    local function apply(inst)
        if inst:IsA("BasePart") then
            if Perf.noShadows then set(inst, "CastShadow", false) end
            if Perf.solidColor and not excluded(inst) then
                set(inst, "Material", Enum.Material.SmoothPlastic)
                set(inst, "MaterialVariant", "")
                set(inst, "Reflectance", 0)
                set(inst, "Color", Perf.color)
                if inst:IsA("MeshPart") then set(inst, "TextureID", "") end
            end
        elseif inst:IsA("Decal") then
            if Perf.solidColor and not excluded(inst) then set(inst, "Transparency", 1) end
        elseif inst:IsA("SurfaceAppearance") then
            if Perf.solidColor and not excluded(inst) then
                detached[#detached + 1] = inst
                set(inst, "Parent", nil)
            end
        elseif EFFECTS[inst.ClassName] then
            if Perf.noEffects then set(inst, "Enabled", false) end
        end
    end

    local function applyGlobal()
        local L = game:GetService("Lighting")
        if Perf.noShadows or Perf.lowLighting then set(L, "GlobalShadows", false) end
        if Perf.lowLighting then
            set(L, "FogEnd", 1e9)
            set(L, "EnvironmentDiffuseScale", 0)
            set(L, "EnvironmentSpecularScale", 0)
            for _, e in L:GetDescendants() do
                if POSTFX[e.ClassName] then
                    set(e, "Enabled", false)
                elseif e:IsA("Atmosphere") then
                    set(e, "Density", 0); set(e, "Haze", 0); set(e, "Glare", 0)
                end
            end
            local t = workspace:FindFirstChildOfClass("Terrain")
            if t then
                set(t, "WaterWaveSize", 0); set(t, "WaterWaveSpeed", 0)
                set(t, "WaterReflectance", 0); set(t, "Decoration", false)
            end
        end
        if Perf.lowQuality then
            pcall(function()
                local r = settings().Rendering
                set(r, "QualityLevel", Enum.QualityLevel.Level01)
                set(r, "MeshPartDetailLevel", Enum.MeshPartDetailLevel.Level01)
            end)
        end
    end

    local function restoreAll()
        for inst, props in saved do
            for prop, v in props do pcall(function() inst[prop] = v end) end
        end
        table.clear(saved); table.clear(detached); table.clear(queue)
    end

    local function anyOn()
        return Perf.solidColor or Perf.noEffects or Perf.noShadows or Perf.lowLighting or Perf.lowQuality
    end

    function Perf.refresh()
        scanToken += 1
        local token = scanToken
        restoreAll()
        if not anyOn() then
            if addConn then addConn:Disconnect(); addConn = nil end
            if queueConn then queueConn:Disconnect(); queueConn = nil end
            return
        end
        applyGlobal()
        if not addConn then
            addConn = track(workspace.DescendantAdded:Connect(function(d) queue[#queue + 1] = d end))
        end
        if not queueConn then
            queueConn = track(RunService.Heartbeat:Connect(function()
                for _ = 1, math.min(#queue, 250) do
                    local inst = table.remove(queue)
                    if inst and inst.Parent then apply(inst) end
                end
            end))
        end
        task.spawn(function()
            for i, inst in workspace:GetDescendants() do
                if token ~= scanToken or State.unloaded then return end
                apply(inst)
                if i % 400 == 0 then task.wait() end
            end
        end)
    end

    function Perf.setFpsCap(v)
        if v > 0 and setfpscap then pcall(setfpscap, v) end
    end

    function Perf.shutdown()
        Perf.solidColor, Perf.noEffects, Perf.noShadows = false, false, false
        Perf.lowLighting, Perf.lowQuality = false, false
        Perf.refresh()
    end
end

-- ── Movement ─────────────────────────────────────────────────────────────────
-- Physics = LinearVelocity + AlignOrientation with PlatformStand at Cfg.moveSpeed, so the
--           root's velocity matches its movement (follows moving goals)
-- Instant = single CFrame set (most likely to be snapped back / flagged)
local Move = { token = 0, noclipFor = {} }
do
    local function params()
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        local ex = { LP.Character }
        for _, f in U.mobFolders() do ex[#ex + 1] = f end
        p.FilterDescendantsInstances = ex
        return p
    end
    Move.params = params

    -- rising out of the ground and attached farm / aura positions always noclip
    local FORCED = { rise = true, lock3d = true, player = true, auraAttach = true, parkour = true, recover = true }
    track(RunService.Stepped:Connect(function()
        if Move.noclipHold or next(Move.noclipFor) == nil then return end
        local forced = false
        for r in Move.noclipFor do if FORCED[r] then forced = true; break end end
        if not forced and not Cfg.noclip then return end
        local c = LP.Character; if not c then return end
        for _, p in c:GetDescendants() do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end))

    function Move.setNoclip(reason, on) Move.noclipFor[reason] = on or nil end
    function Move.cancel() Move.token += 1 end

    -- true when we're (nearly) straight below pos, e.g. after sinking under the map
    function Move.isUnder(pos, flatRange)
        local hrp = U.hrp()
        if not (hrp and pos) then return false end
        local d = pos - hrp.Position
        return d.Y > 4 and Vector3.new(d.X, 0, d.Z).Magnitude <= (flatRange or 6)
    end

    -- slowly lifts the character straight up to height y (out of the ground)
    function Move.rise(y)
        Move.setNoclip("rise", true)
        local t0 = os.clock()
        while not State.unloaded and os.clock() - t0 < 15 do
            local hrp = U.hrp()
            if not (hrp and U.alive()) then break end
            local dt = RunService.Heartbeat:Wait()
            local p = hrp.Position
            if p.Y >= y then break end
            hrp.CFrame = CFrame.new(p.X, math.min(y, p.Y + Cfg.riseSpeed * dt), p.Z) * hrp.CFrame.Rotation
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        Move.setNoclip("rise", false)
        local hum = U.hum()
        if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    end

    -- anything solid (parts or terrain) where the character's body would be
    local function solidAt(pos)
        local op = OverlapParams.new()
        op.FilterType = Enum.RaycastFilterType.Exclude
        local ex = { LP.Character, workspace.Terrain }
        for _, f in U.mobFolders() do ex[#ex + 1] = f end
        op.FilterDescendantsInstances = ex
        for _, p in workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(3, 5, 3), op) do
            if p.CanCollide then return true end
        end
        local ok, mats = pcall(function()
            local r = Region3.new(pos - Vector3.new(2, 3, 2), pos + Vector3.new(2, 3, 2)):ExpandToGrid(4)
            return workspace.Terrain:ReadVoxels(r, 4)
        end)
        if ok and mats then
            local size = mats.Size
            for x = 1, size.X do for y = 1, size.Y do for z = 1, size.Z do
                local m = mats[x][y][z]
                if m ~= Enum.Material.Air and m ~= Enum.Material.Water then return true end
            end end end
        end
        return false
    end

    -- teleports up 5 studs at a time until nothing overlaps the character and the level line
    -- toward `toward` is open; returns true once clear
    function Move.climbClear(toward, maxHops)
        local rp = params()
        for _ = 1, maxHops or 40 do
            local hrp = U.hrp(); if not hrp then return false end
            local pos = hrp.Position
            local open = not solidAt(pos)
            if open and toward then
                local flat = Vector3.new(toward.X - pos.X, 0, toward.Z - pos.Z)
                if flat.Magnitude > 1 then
                    open = workspace:Raycast(pos, flat.Unit * math.min(flat.Magnitude, 60), rp) == nil
                end
            end
            if open then return true end
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 5, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
            task.wait(0.05)
        end
        return false
    end

    -- moves through the physics engine: the root's velocity matches how fast it actually travels,
    -- unlike CFrame stepping where velocity stays 0 while the position jumps every frame
    local function physics(goalFn, opts, token)
        local hrp, hum = U.hrp(), U.hum()
        if not (hrp and hum) then return false end
        local att = Instance.new("Attachment")
        att.Name = "ZenithMove"
        att.Parent = hrp
        local lv = Instance.new("LinearVelocity")
        lv.Attachment0 = att
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        lv.MaxForce = math.huge
        lv.VectorVelocity = Vector3.zero
        lv.Parent = hrp
        local ao = Instance.new("AlignOrientation")
        ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
        ao.Attachment0 = att
        ao.MaxTorque = math.huge
        ao.Responsiveness = 60
        ao.CFrame = hrp.CFrame.Rotation
        ao.Parent = hrp
        local wasStand = hum.PlatformStand
        hum.PlatformStand = true
        Move.moving = true

        local stopDist = opts.stopDist or 2
        local best, lastProg = math.huge, os.clock()
        local rp = opts.dynamic and params()
        local result, why = false, nil
        -- server snapbacks: going straight through the same objects again just gets reset again,
        -- so after one we go up and over them with collisions on, a bit slower each time
        local lastPos, snaps, detour, overY, speedMul, hops = hrp.Position, 0, nil, 0, 1, 0
        -- climb clear, keep that altitude until above the goal, then drop onto it
        local function overhead(g)
            lv.VectorVelocity = Vector3.zero
            rp = rp or params()
            Move.climbClear(g.Position)
            local r = U.hrp()
            if r then
                overY, detour = r.Position.Y, "over"
                lastPos, best, lastProg = r.Position, math.huge, os.clock()
            end
        end
        if opts.overhead then
            local g0 = goalFn()
            if g0 then overhead(g0) end
        end
        while true do
            if token ~= Move.token or State.unloaded or (opts.cancel and opts.cancel()) then break end
            local dt = RunService.Heartbeat:Wait()
            hrp = U.hrp()
            local g = goalFn()
            if not (hrp and g and U.alive() and lv.Parent == hrp) then break end
            local pos = hrp.Position
            local jump = (pos - lastPos).Magnitude
            if jump > math.max(8, Cfg.moveSpeed * dt * 3)
                and (g.Position - pos).Magnitude > (g.Position - lastPos).Magnitude + 4 then
                snaps += 1
                if snaps >= 4 then why = "stuck"; break end
                lv.VectorVelocity = Vector3.zero
                hrp.AssemblyLinearVelocity = Vector3.zero
                task.wait(0.35)
                speedMul = math.max(0.4, speedMul * 0.75)
                rp = rp or params()
                overhead(g)
                hrp = U.hrp(); if not hrp then break end
                pos = hrp.Position
            end
            lastPos = pos

            local aim, isGoal = g.Position, true
            if detour == "over" then
                aim, isGoal = Vector3.new(g.Position.X, overY, g.Position.Z), false
                if Vector3.new(aim.X - pos.X, 0, aim.Z - pos.Z).Magnitude < stopDist + 2 then
                    detour, best, aim, isGoal = nil, math.huge, g.Position, true
                end
            end
            Move.noclipHold = detour == "over" or nil

            local delta = aim - pos
            local dist = delta.Magnitude
            if isGoal and dist <= stopDist then
                lv.VectorVelocity = Vector3.zero
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.CFrame = g
                result = true
                break
            end
            if dist < 0.05 then continue end
            local dir = delta.Unit
            if rp and (detour or not Cfg.noclip) and workspace:Raycast(pos, dir * 5, rp) then
                dir = (dir + Vector3.new(0, 2, 0)).Unit -- climb over the obstacle
            end
            -- ease in over the last few studs so we don't overshoot
            lv.VectorVelocity = dir * math.min(Cfg.moveSpeed * speedMul, math.max(dist * 4, 4))
            local flat = Vector3.new(delta.X, 0, delta.Z)
            if flat.Magnitude > 0.1 then ao.CFrame = CFrame.lookAt(Vector3.zero, flat) end
            local stallLimit = opts.stallTime or (detour and 4)
            local since = os.clock() - lastProg
            if dist < best - 1 then best, lastProg = dist, os.clock()
            elseif hops < 2 and since > math.min(stallLimit or 1.5, 1.5) then
                -- caught on something: short instant hop toward where we're heading
                hops += 1
                hrp.CFrame = hrp.CFrame + dir * math.min(6, dist)
                hrp.AssemblyLinearVelocity = Vector3.zero
                lastPos, best, lastProg = hrp.Position, math.huge, os.clock()
            elseif stallLimit and since > stallLimit then
                if detour == "over" then detour, best, lastProg = nil, math.huge, os.clock() -- blocked up there too
                else why = "stuck"; break end
            end
        end
        Move.noclipHold, Move.moving = nil, false
        pcall(function() lv:Destroy(); ao:Destroy(); att:Destroy() end)
        if hum.Parent then
            hum.PlatformStand = wasStand
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        local root = U.hrp()
        if root then root.AssemblyLinearVelocity = Vector3.zero end
        return result, why
    end

    -- goalFn() -> CFrame | nil. Returns true on arrival, or false[, "stuck"].
    function Move.go(goalFn, opts)
        opts = opts or {}
        Move.token += 1
        local token, mode = Move.token, opts.mode or Cfg.moveMode
        local hrp = U.hrp()
        if not hrp or not U.alive() then return false end
        if mode == "Instant" then
            local g = goalFn(); if not g then return false end
            hrp.CFrame = g
            hrp.AssemblyLinearVelocity = Vector3.zero
            return true
        end
        return physics(goalFn, opts, token)
    end

    -- puts the character upright on the ground under/near its current spot
    function Move.standUp()
        local hrp, hum = U.hrp(), U.hum()
        if not (hrp and hum) then return end
        local pos = hrp.Position
        local hit = workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -200, 0), params())
        local y = hit and hit.Position.Y + 3.5 or pos.Y + 5
        local look = hrp.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.1 then flat = Vector3.zAxis end
        local p = Vector3.new(pos.X, y, pos.Z)
        hrp.CFrame = CFrame.lookAt(p, p + flat)
        hrp.AssemblyLinearVelocity = Vector3.zero
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end

    -- stands a few studs behind an NPC
    function Move.toNpc(model)
        if not Npc.valid(model) then return false end
        Move.setNoclip("tp", true)
        local ok = Move.go(function()
            local t = U.hrp(model); if not t then return nil end
            local p = t.Position - t.CFrame.LookVector * 5
            return CFrame.lookAt(p, Vector3.new(t.Position.X, p.Y, t.Position.Z))
        end, { stopDist = 2, cancel = function() return not Npc.valid(model) end })
        Move.setNoclip("tp", false)
        return ok
    end
end

-- ── View: camera + world visibility ──────────────────────────────────────────
-- The game's Humanoid handler resets the zoom limits every 0.075s and the day cycle moves
-- the clock, so these are reapplied every frame right after the camera updates.
local View = {}
do
    local L = game:GetService("Lighting")
    local CAS = game:GetService("ContextActionService")
    local StarterGui = game:GetService("StarterGui")
    local orig = {} -- [group] = { [inst] = { [prop] = original value } }

    local function hold(group, inst, prop, value)
        local g = orig[group]; if not g then g = {}; orig[group] = g end
        local s = g[inst]; if not s then s = {}; g[inst] = s end
        if s[prop] == nil then
            local ok, v = pcall(function() return inst[prop] end)
            if not ok then return end
            s[prop] = v
        end
        pcall(function() if inst[prop] ~= value then inst[prop] = value end end)
    end
    local function release(group)
        local g = orig[group]; if not g then return end
        for inst, props in g do
            for prop, v in props do pcall(function() inst[prop] = v end) end
        end
        orig[group] = nil
    end

    local function setLtm(model, v)
        if not model then return end
        for _, d in model:GetDescendants() do
            if d:IsA("BasePart") or d:IsA("Decal") then d.LocalTransparencyModifier = v end
        end
    end

    -- freecam: WASD / QE move, hold right mouse to look, Shift = faster
    local fc = { on = false }
    local SINK = { Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space,
                   Enum.KeyCode.Q, Enum.KeyCode.E, Enum.KeyCode.LeftShift, Enum.KeyCode.LeftControl }
    function View.setFreecam(on)
        if on == fc.on then return end
        fc.on, Cfg.freecam = on, on
        local cam = workspace.CurrentCamera
        if on then
            local cf = cam.CFrame
            local look = cf.LookVector
            fc.pos = cf.Position
            fc.yaw = math.atan2(-look.X, -look.Z)
            fc.pitch = math.asin(math.clamp(look.Y, -1, 1))
            fc.type = cam.CameraType
            pcall(function()
                CAS:BindActionAtPriority("ZenithFreecam", function() return Enum.ContextActionResult.Sink end,
                    false, 3000, table.unpack(SINK))
            end)
        else
            pcall(function() CAS:UnbindAction("ZenithFreecam") end)
            cam.CameraType = fc.type or Enum.CameraType.Custom
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        end
    end
    local function freecamStep(cam, dt)
        if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
            local d = UIS:GetMouseDelta()
            fc.yaw -= d.X * 0.004
            fc.pitch = math.clamp(fc.pitch - d.Y * 0.004, -1.5, 1.5)
        else
            UIS.MouseBehavior = Enum.MouseBehavior.Default
        end
        local rot = CFrame.fromOrientation(fc.pitch, fc.yaw, 0)
        local mv = Vector3.zero
        if not UIS:GetFocusedTextBox() then
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv += Vector3.new(0, 0, -1) end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv += Vector3.new(0, 0, 1) end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv += Vector3.new(-1, 0, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv += Vector3.new(1, 0, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.E) then mv += Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.Q) then mv += Vector3.new(0, -1, 0) end
        end
        local spd = Cfg.freecamSpeed * (UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1)
        fc.pos += rot:VectorToWorldSpace(mv) * spd * dt
        cam.CFrame = CFrame.new(fc.pos) * rot
    end

    local selfHidden = false
    function View.showSelf()
        if selfHidden then selfHidden = false; setLtm(LP.Character, 0) end
    end

    local function frame(dt)
        if Cfg.fullbright then
            hold("bright", L, "Brightness", 2)
            hold("bright", L, "ClockTime", 14)
            hold("bright", L, "GlobalShadows", false)
            hold("bright", L, "Ambient", Color3.fromRGB(178, 178, 178))
            hold("bright", L, "OutdoorAmbient", Color3.fromRGB(178, 178, 178))
        elseif orig.bright then release("bright") end

        if Cfg.noFog then
            hold("fog", L, "FogStart", 1e9)
            hold("fog", L, "FogEnd", 1e9)
            local atm = L:FindFirstChildOfClass("Atmosphere")
            if atm then hold("fog", atm, "Density", 0); hold("fog", atm, "Haze", 0) end
        elseif orig.fog then release("fog") end

        local cam = workspace.CurrentCamera
        if Cfg.zoomOn then LP.CameraMaxZoomDistance = Cfg.maxZoom end
        if Cfg.thirdPerson then
            hold("third", LP, "CameraMode", Enum.CameraMode.Classic)
            if LP.CameraMinZoomDistance < 6 then LP.CameraMinZoomDistance = 6 end
        elseif orig.third then release("third") end
        if Cfg.fovOn then hold("fov", cam, "FieldOfView", Cfg.fov)
        elseif orig.fov then release("fov") end
        if Cfg.camThroughWalls then hold("walls", LP, "DevCameraOcclusionMode", Enum.DevCameraOcclusionMode.Invisicam)
        elseif orig.walls then release("walls") end
        if fc.on then freecamStep(cam, dt) end

        if Cfg.hideSelf and LP.Character then
            setLtm(LP.Character, 1)
            selfHidden = true
        end
    end
    RunService:BindToRenderStep("ZenithView", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if not State.unloaded then frame(dt) end
    end)

    -- X-Ray / Hide World: local-only transparency on map parts (characters are skipped).
    -- Restoring rescans the world: weak tables keyed by instances drop entries, so they can't be trusted.
    local mapConn, mapToken, mapTouched = nil, 0, false
    local function mapValue() return Cfg.hideMap and 1 or (Cfg.xray and 0.6 or 0) end
    local function isMapPart(p)
        if not p:IsA("BasePart") or p:IsA("Terrain") then return false end
        local m = p:FindFirstAncestorWhichIsA("Model")
        return not (m and (m:FindFirstChild("Humanoid") or m:FindFirstChild("HumanoidRootPart")))
    end
    local function applyPart(p, v)
        if isMapPart(p) then p.LocalTransparencyModifier = v end
    end
    function View.refreshMap()
        mapToken += 1
        local token, v = mapToken, mapValue()
        if v == 0 then
            if mapConn then mapConn:Disconnect(); mapConn = nil end
            if not mapTouched then return end
            mapTouched = false
            task.spawn(function()
                for i, d in workspace:GetDescendants() do
                    if token ~= mapToken then return end
                    if d:IsA("BasePart") and d.LocalTransparencyModifier ~= 0 and isMapPart(d) then
                        d.LocalTransparencyModifier = 0
                    end
                    if i % 1000 == 0 then task.wait() end
                end
            end)
            return
        end
        mapTouched = true
        if not mapConn then
            mapConn = track(workspace.DescendantAdded:Connect(function(d)
                local val = mapValue()
                if val > 0 then task.defer(function() if d.Parent then applyPart(d, val) end end) end
            end))
        end
        task.spawn(function()
            for i, d in workspace:GetDescendants() do
                if token ~= mapToken or State.unloaded then return end
                applyPart(d, v)
                if i % 500 == 0 then task.wait() end
            end
        end)
    end

    -- Hide Other Players + Streamer Mode (overhead name tags and the player list) + Hide Minimap
    local othersHidden, streamOn = false, false
    local tags, hiddenGui = {}, {}
    function View.stepOthers()
        if Cfg.hideMinimap then
            for _, d in PlayerGui:GetDescendants() do
                if d.Name == "Minimap" then
                    if d:IsA("ScreenGui") then
                        if d.Enabled then hiddenGui[d] = "Enabled"; d.Enabled = false end
                    elseif d:IsA("GuiObject") and d.Visible then
                        hiddenGui[d] = "Visible"; d.Visible = false
                    end
                end
            end
        elseif next(hiddenGui) then
            for g, prop in hiddenGui do pcall(function() g[prop] = true end) end
            table.clear(hiddenGui)
        end
        if Cfg.hideOthers then
            for _, p in Players:GetPlayers() do
                if p ~= LP then setLtm(p.Character, 1) end
            end
            othersHidden = true
        elseif othersHidden then
            othersHidden = false
            for _, p in Players:GetPlayers() do
                if p ~= LP then setLtm(p.Character, 0) end
            end
        end
        if Cfg.streamer then
            for _, p in Players:GetPlayers() do
                local c = p.Character
                if c then
                    for _, d in c:GetDescendants() do
                        if d:IsA("BillboardGui") and d.Enabled then tags[d] = true; d.Enabled = false end
                    end
                end
            end
            if not streamOn then
                streamOn = true
                pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.PlayerList, false)
            end
        elseif streamOn then
            streamOn = false
            for g in tags do pcall(function() g.Enabled = true end) end
            table.clear(tags)
            pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.PlayerList, true)
        end
    end
    task.spawn(function()
        while not State.unloaded do
            pcall(View.stepOthers)
            task.wait(0.5)
        end
    end)

    function View.set3d(off)
        pcall(function() RunService:Set3dRenderingEnabled(not off) end)
    end

    function View.shutdown()
        pcall(function() RunService:UnbindFromRenderStep("ZenithView") end)
        View.setFreecam(false)
        Cfg.fullbright, Cfg.noFog, Cfg.camThroughWalls = false, false, false
        Cfg.fovOn, Cfg.zoomOn, Cfg.thirdPerson = false, false, false
        for group in orig do release(group) end
        Cfg.xray, Cfg.hideMap = false, false
        View.refreshMap()
        Cfg.hideOthers, Cfg.streamer, Cfg.hideMinimap = false, false, false
        pcall(View.stepOthers)
        Cfg.hideSelf = false
        View.showSelf()
        View.set3d(false)
    end
end


-- ── Shared state for the game features ───────────────────────────────────────
local Farm = { on = false, phase = "Idle", locking = false, lastPos = nil, voidAt = 0, chopped = 0 }
local Combat = { status = "Off", lastSwing = 0, lastTree = 0, hits = 0, treeHits = 0 }
local Gather = { status = "Idle", fuelStatus = "Off", cookStatus = "Off", scrapStatus = "Off", brought = 0, burned = 0 }
local Survival = { status = "Idle", eaten = 0, healed = 0 }
local Fish = { status = "Off", caught = 0 }
local Kids = { status = "Off", rescued = 0 }
local World = { notify = nil, status = "" }
local Lobby = { status = "Off" }
local Tweak = {}
local Job = { busy = nil }
local Hover = { active = false, status = "Off", threats = 0 }
local Afk = { status = "Off" }

local function fmtSec(sec)
    sec = math.max(0, math.floor(sec))
    if sec >= 3600 then return string.format("%dh %02dm", sec // 3600, (sec % 3600) // 60) end
    if sec >= 60 then return string.format("%dm %02ds", sec // 60, sec % 60) end
    return sec .. "s"
end

-- one teleporting task at a time (chests, kids, warming up, revives); returns you to where you were
do
    function Job.run(name, fn, stay)
        if Job.busy or State.unloaded or not U.alive() then return false end
        Job.busy = name
        local hrp = U.hrp()
        local back = hrp and hrp.CFrame
        local ok, err = pcall(fn)
        if back and not stay and U.alive() then
            local r = U.hrp()
            if r then r.CFrame = back; r.AssemblyLinearVelocity = Vector3.zero end
        end
        Job.busy = nil
        return ok, err
    end
end

-- ── Game tweaks ──────────────────────────────────────────────────────────────
do
    local lastSprint = 0
    function Tweak.running() local h = U.hum(); return h ~= nil and h.WalkSpeed > 20 end
    function Tweak.stunned() return false end
    track(RunService.Heartbeat:Connect(function()
        if State.unloaded or not Cfg.alwaysSprint then return end
        local h = U.hum()
        if not h or h.MoveDirection.Magnitude < 0.1 or os.clock() - lastSprint < 1.5 then return end
        lastSprint = os.clock()
        G.fire("PlayerSprinting", true)
        if h.WalkSpeed < 29 then h.WalkSpeed = 29 end
    end))
    function Tweak.shutdown() Cfg.alwaysSprint = false end
end

-- ── Combat: weapons + Kill Aura + Tree Aura ──────────────────────────────────
-- Hits go through ToolDamageObject(target, inventory tool, hit id, root CFrame), the same call the
-- game's swing makes for every model in its hit box. Each swing waits out the tool's ToolCooldown.
do
    local RANGED = { Firearm = true, ThrownWeapon = true, Flamethrower = true }
    local AXES = { GenericAxe = true, Chainsaw = true }

    function Combat.weapons()
        local out = {}
        for _, it in G.invItems() do
            local tn = it:GetAttribute("ToolName")
            if it:GetAttribute("WeaponDamage") ~= nil and not RANGED[tn] then out[#out + 1] = it end
        end
        table.sort(out, function(a, b) return (a:GetAttribute("WeaponDamage") or 0) > (b:GetAttribute("WeaponDamage") or 0) end)
        return out
    end
    function Combat.weaponNames()
        local out, seen = { "Best Weapon" }, {}
        for _, it in Combat.weapons() do
            if not seen[it.Name] then seen[it.Name] = true; out[#out + 1] = it.Name end
        end
        return out
    end
    function Combat.weapon()
        local list = Combat.weapons()
        if Cfg.auraWeapon ~= "Best Weapon" then
            for _, it in list do if it.Name == Cfg.auraWeapon then return it end end
        end
        return list[1]
    end
    -- best axe allowed to cut a tree of this tier
    function Combat.axe(tree)
        local best, bestDmg
        for _, it in G.invItems() do
            local tn = it:GetAttribute("ToolName")
            if AXES[tn] and (not tree or tree:GetAttribute("AllowTool_" .. tn)) then
                local tier = it:GetAttribute("ToolTier") or 1
                local need = tree and (tree:GetAttribute("ToolTier") or 1) or 1
                if tier >= need or (it:GetAttribute("AxeLevel") or 0) >= 3 then
                    local dmg = it:GetAttribute("WeaponResourceDamage") or 10
                    if not bestDmg or dmg > bestDmg then best, bestDmg = it, dmg end
                end
            end
        end
        return best
    end
    local function cooldownOf(tool) return math.max(0.15, tonumber(tool:GetAttribute("ToolCooldown")) or 0.5) end

    local function hit(target, tool, isTree)
        local hrp = U.hrp()
        if not hrp then return end
        task.spawn(function()
            local res = G.invoke("ToolDamageObject", target, tool, G.hitId(), hrp.CFrame)
            if G.ok(res) then
                if isTree then Combat.treeHits += 1 else Combat.hits += 1 end
            end
        end)
    end

    function Combat.targets()
        local me = U.hrp()
        if not me then return {} end
        local out = {}
        if Cfg.auraMobs then
            for _, m in Npc.list() do
                if Npc.attackable(m) and not (Cfg.auraSkipPassive and Npc.passive(m)) then
                    local d = (Npc.root(m).Position - me.Position).Magnitude
                    if d <= Cfg.auraRange then out[#out + 1] = { m = m, d = d } end
                end
            end
        end
        if Cfg.auraPlayers then
            for _, p in Players:GetPlayers() do
                local c = p ~= LP and p.Character
                local r = c and U.hrp(c)
                if r and U.alive(c) then
                    local d = (r.Position - me.Position).Magnitude
                    if d <= Cfg.auraRange then out[#out + 1] = { m = c, d = d } end
                end
            end
        end
        table.sort(out, function(a, b) return a.d < b.d end)
        local list = {}
        for i = 1, math.min(#out, Cfg.auraTargets) do list[i] = out[i].m end
        return list
    end

    -- trees: models in Map.Foliage / Map.Landmarks with a Resource attribute and Health left
    local trees, scannedAt = {}, 0
    function Combat.trees()
        if os.clock() - scannedAt < 3 then return trees end
        scannedAt = os.clock()
        local out = {}
        local map = G.map()
        for _, name in { "Foliage", "Landmarks" } do
            local f = map and map:FindFirstChild(name)
            for _, m in (f and f:GetChildren() or {}) do
                if m:IsA("Model") and m:GetAttribute("Resource") == "Tree" then out[#out + 1] = m end
            end
        end
        trees = out
        return out
    end
    function Combat.treeOk(t)
        if not (t.Parent and t:IsDescendantOf(workspace)) or t:GetAttribute("Destroyed") then return false end
        if (tonumber(t:GetAttribute("Health")) or 1) <= 0 then return false end
        if Cfg.treeKind == "Small Trees Only" and t.Name ~= "Small Tree" then return false end
        if not G.inBounds(t:GetPivot().Position, 6) then return false end
        return Combat.axe(t) ~= nil
    end
    function Combat.treesNear(range, from)
        from = from or (U.hrp() and U.hrp().Position)
        if not from then return {} end
        local out = {}
        for _, t in Combat.trees() do
            if Combat.treeOk(t) then
                local d = (t:GetPivot().Position - from).Magnitude
                if d <= range then out[#out + 1] = { t = t, d = d } end
            end
        end
        table.sort(out, function(a, b) return a.d < b.d end)
        local list = {}
        for i, e in out do list[i] = e.t end
        return list
    end

    function Combat.step()
        if not U.alive() then Combat.status = Cfg.killAura and "Dead" or "Off"; return end
        local now = os.clock()
        -- mobs first
        if Cfg.killAura then
            local list = Combat.targets()
            if #list > 0 then
                local tool = Combat.weapon()
                if not tool then Combat.status = "No melee weapon in your inventory"; return end
                if now - Combat.lastSwing < cooldownOf(tool) then return end
                if not G.equip(tool) then Combat.status = "Couldn't equip " .. tool.Name; return end
                Combat.lastSwing = now
                for _, m in list do hit(m, tool, false) end
                Combat.status = string.format("Hitting %s%s with %s", list[1].Name, #list > 1 and (" +" .. (#list - 1)) or "", tool.Name)
                return
            end
            Combat.status = "No targets in range"
        else
            Combat.status = "Off"
        end
        -- then trees
        if Cfg.treeAura or Farm.chopping then
            local list = Combat.treesNear(Cfg.treeRange)
            local t = list[1]
            if not t then return end
            local tool = Combat.axe(t)
            if not tool or now - Combat.lastTree < cooldownOf(tool) then return end
            if not G.equip(tool) then return end
            Combat.lastTree = now
            local n = 0
            for _, tr in list do
                if n >= Cfg.auraTargets then break end
                if Combat.axe(tr) == tool then hit(tr, tool, true); n += 1 end
            end
        end
    end

    -- healing items: inventory first, then any close by on the ground
    function Combat.heal()
        local hum = U.hum()
        if not hum or hum.Health <= 0 or hum.Health / hum.MaxHealth * 100 >= Cfg.healAt then return end
        for _, it in G.invItems() do
            if it:GetAttribute("RestoreHealth") ~= nil then
                local inv = G.mod("InventoryUI")
                local one = inv and inv.GetLatestFromItemStack and G.try(function() return inv.GetLatestFromItemStack(it) end) or it
                if G.ok(G.invoke("RequestConsumeItem", one)) then Survival.healed += 1 end
                return
            end
        end
        for _, it in Items.find("Healing", 60) do
            if G.ok(G.invoke("RequestConsumeItem", it)) then Survival.healed += 1 end
            return
        end
    end
end

-- ── Gathering: auto chop, bring items, campfire, cooking, scrapper ───────────
do
    local function say(t, m, k) if World.notify then World.notify(t, m, k) end end
    Gather.DESTS = { "Me", "Campfire", "Next To Campfire", "Scrapper", "Crafting Bench" }

    -- where brought items get dropped; spread a little so piles don't explode
    local function destCF(dest, i)
        local jitter = Vector3.new(math.random(-20, 20) / 10, 0, math.random(-20, 20) / 10)
        if dest == "Me" then
            local hrp = U.hrp()
            return hrp and (hrp.CFrame * CFrame.new(jitter.X, 1 + (i % 4), -5 + jitter.Z))
        elseif dest == "Campfire" then
            return CFrame.new(G.firePos() + Vector3.new(0, 5 + (i % 3), 0) + jitter * 0.4)
        elseif dest == "Next To Campfire" then
            return CFrame.new(G.firePos() + Vector3.new(14, 4 + (i % 4), 0) + jitter)
        elseif dest == "Scrapper" then
            local p = G.scrapPos()
            return p and CFrame.new(p + Vector3.new(0, 4 + (i % 3), 0) + jitter * 0.3)
        elseif dest == "Crafting Bench" then
            local p = G.benchPos()
            return p and CFrame.new(p + Vector3.new(6, 4 + (i % 4), 0) + jitter)
        end
        return nil
    end
    Gather.destCF = destCF

    -- after landing: let the fire / scrapper take it even if its touch zone missed it
    local function finish(it, dest)
        task.delay(0.5, function()
            if not it.Parent then return end
            if dest == "Campfire" then
                local fire = G.mainFire()
                if Items.isFuel(it) then G.fire("RequestBurnItem", fire, it); Gather.burned += 1
                elseif Items.isRaw(it) and (G.fuel()) > 0 then G.fire("RequestCookItem", fire, it) end
            elseif dest == "Scrapper" and (Items.isScrap(it) or Items.isGem(it)) then
                G.invoke("RequestScrapItem", G.scrapper(), it)
            end
        end)
    end

    function Gather.bring(kind, dest, max, range)
        local me = U.hrp()
        if not me then return 0 end
        local list = Items.find(kind, range or Cfg.bringRange, me.Position, max or Cfg.bringMax)
        local n = 0
        for i, it in list do
            if State.unloaded then break end
            local cf = destCF(dest, i)
            if cf and G.drag(it, cf) then
                n += 1
                finish(it, dest)
                task.wait(0.12)
            end
        end
        Gather.brought += n
        return n
    end

    -- campfire: keep the fuel above the chosen percentage
    local function fuelKindOk(it)
        if not Items.isFuel(it) then return false end
        if Cfg.fuelKind == "Logs Only" then return Items.isLog(it) end
        if Cfg.fuelKind == "Save Logs" then return not Items.isLog(it) end
        return true
    end
    function Gather.fuelStep()
        if not Cfg.autoFuel then Gather.fuelStatus = "Off"; return end
        local left, target = G.fuel()
        local pct = left / target * 100
        -- filling the fire to 100% levels it up, which pushes the forest wall back
        local prio = Cfg.firePriority and G.fireLevel() < 6
        local goalPct = prio and 100 or Cfg.fuelAt
        if pct >= goalPct then Gather.fuelStatus = string.format("Fire lvl %d at %d%%", G.fireLevel(), math.floor(pct)); return end
        local fp = G.firePos()
        local cands = {}
        for _, it in G.items() do
            if Items.usable(it) and (prio and Items.isFuel(it) or fuelKindOk(it)) then
                local p = G.itemPos(it)
                if p then cands[#cands + 1] = { it = it, d = (p - fp).Magnitude } end
            end
        end
        table.sort(cands, function(a, b) return a.d < b.d end)
        if #cands == 0 then Gather.fuelStatus = string.format("Fire lvl %d at %d%% · no fuel found", G.fireLevel(), math.floor(pct)); return end
        for i = 1, math.min(prio and 8 or 3, #cands) do
            local it = cands[i].it
            if G.drag(it, destCF("Campfire", i)) then finish(it, "Campfire") end
            task.wait(0.15)
        end
        Gather.fuelStatus = string.format("Fire lvl %d at %d%% · %s", G.fireLevel(), math.floor(pct), prio and "leveling up" or "fueling")
    end

    function Gather.cookStep()
        if not Cfg.autoCook then Gather.cookStatus = "Off"; return end
        if (G.fuel()) <= 0 then Gather.cookStatus = "Fire is out"; return end
        local list = Items.find("Raw Meat", Cfg.bringRange, G.firePos(), 4)
        if #list == 0 then Gather.cookStatus = "Nothing to cook"; return end
        for i, it in list do
            if G.drag(it, destCF("Campfire", i)) then finish(it, "Campfire") end
            task.wait(0.15)
        end
        Gather.cookStatus = "Cooking " .. list[1].Name
    end

    function Gather.scrapStep()
        if not (Cfg.autoScrap or Cfg.scrapLogs) then Gather.scrapStatus = "Off"; return end
        if not G.scrapPos() then Gather.scrapStatus = "No scrapper found"; return end
        local n = 0
        if Cfg.autoScrap then
            for i, it in Items.find("Scrap", Cfg.bringRange, nil, 4) do
                if not Items.isLog(it) and G.drag(it, destCF("Scrapper", i)) then finish(it, "Scrapper"); n += 1 end
                task.wait(0.15)
            end
            if Cfg.scrapGems then
                for i, it in Items.find("Cultist Gems", math.max(Cfg.bringRange, 2000), nil, 4) do
                    if G.drag(it, destCF("Scrapper", i)) then finish(it, "Scrapper"); n += 1 end
                    task.wait(0.15)
                end
            end
        end
        -- logs stay with the fire until it's maxed when the campfire comes first
        if Cfg.scrapLogs and not (Cfg.firePriority and G.fireLevel() < 6) then
            for i, it in Items.find("Logs", Cfg.bringRange, nil, 4) do
                if G.drag(it, destCF("Scrapper", i)) then finish(it, "Scrapper"); n += 1 end
                task.wait(0.15)
            end
        end
        Gather.scrapStatus = n > 0 and ("Scrapped " .. n) or "Nothing to scrap"
    end

    -- auto chop: walk up to the nearest tree and let the tree hits run until it's down
    function Gather.chopStep()
        Farm.on = Cfg.autoChop
        if not Cfg.autoChop or Job.busy or not U.alive() then Farm.chopping = false; return end
        if Cfg.nightSafe and G.isNight() then Farm.phase = "Night · staying at camp"; Farm.chopping = false; return end
        if Hover.active then Farm.phase = "Enemies nearby · fighting from above"; Farm.chopping, Farm.locking = false, false; return end
        local near = Combat.treesNear(Cfg.treeRange)[1]
        if near then
            Farm.chopping, Farm.locking = true, true
            Farm.phase = "Chopping " .. near.Name
            Farm.lastPos = near:GetPivot().Position
            return
        end
        Farm.locking = false
        local t = Combat.treesNear(Cfg.chopRange)[1]
        if not t then Farm.phase = "No trees in range you can cut"; Farm.chopping = false; return end
        Farm.phase = "Going to " .. t.Name
        Farm.chopping = true
        local pos = t:GetPivot().Position
        Move.setNoclip("chop", true)
        Move.go(function()
            local me = U.hrp()
            if not me then return nil end
            local flat = Vector3.new(me.Position.X - pos.X, 0, me.Position.Z - pos.Z)
            local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.xAxis
            local stand = pos + dir * 4 + Vector3.new(0, 3, 0)
            return CFrame.lookAt(stand, Vector3.new(pos.X, stand.Y, pos.Z))
        end, { stopDist = 3, cancel = function() return not Cfg.autoChop or Job.busy ~= nil or Hover.active or not Combat.treeOk(t) end })
        Move.setNoclip("chop", false)
    end

    function Gather.diamondStep()
        if not Cfg.autoDiamonds or (Cfg.nightSafe and G.isNight()) then return end
        local list = {}
        for _, it in G.items() do
            if it:GetAttribute("Diamonds") ~= nil and G.root(it) and G.inBounds(G.itemPos(it)) then list[#list + 1] = it end
        end
        if #list == 0 then return end
        Job.run("Collecting diamonds", function()
            for _, it in list do
                if not it.Parent or State.unloaded then continue end
                U.tp(G.itemPos(it), 2)
                task.wait(0.2)
                G.fire("RequestTakeDiamonds", it)
                task.wait(0.2)
            end
        end)
    end

    function Gather.chestStep()
        if not Cfg.autoChests or (Cfg.nightSafe and G.isNight()) then return end
        local me = U.hrp()
        if not me then return end
        local list = {}
        for _, c in Items.chests(false) do
            local p = G.itemPos(c)
            if p and not c:GetAttribute("Locked") and G.inBounds(p) and (p - me.Position).Magnitude <= Cfg.chestRange then
                list[#list + 1] = { c = c, d = (p - me.Position).Magnitude }
            end
        end
        if #list == 0 then return end
        table.sort(list, function(a, b) return a.d < b.d end)
        Job.run("Opening chests", function()
            for i = 1, math.min(#list, 6) do
                local c = list[i].c
                if State.unloaded or not c.Parent or Items.chestOpened(c) then continue end
                local cf = c:GetPivot()
                U.tp(cf.Position + cf.LookVector * 4, 2)
                task.wait(0.3)
                local ih = G.mod("InteractionHandler")
                local opener = ih and ih.Interactions and ih.Interactions.ItemChest
                if not (opener and pcall(opener, c)) then G.fire("RequestOpenItemChest", c) end
                Gather.status = "Opened " .. c.Name
                task.wait(0.4)
            end
        end)
    end

    -- saplings: planted in a ring around camp (the game wants 40+ studs from the fire)
    local plantAngle = 0
    function Gather.plantStep()
        if not Cfg.autoPlant then return end
        local list = Items.find("Saplings", 2000, G.firePos(), 3)
        if #list == 0 then return end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Include
        local map = G.map()
        rp.FilterDescendantsInstances = { map and map:FindFirstChild("Ground") or workspace.Terrain, map and map:FindFirstChild("Snow") or workspace.Terrain }
        local fp = G.firePos()
        for _, it in list do
            local r = math.max(Cfg.plantRadius, it.Name == "Giant Sapling" and 55 or 44)
            plantAngle += math.rad(9)
            local flat = fp + Vector3.new(math.cos(plantAngle) * r, 0, math.sin(plantAngle) * r)
            local hit = workspace:Raycast(flat + Vector3.new(0, 60, 0), Vector3.new(0, -140, 0), rp)
            if hit then G.invoke("RequestPlantItem", it, hit.Position) end
            task.wait(0.3)
        end
    end

    -- auto bring on a timer
    local lastBring = 0
    function Gather.autoBringStep()
        if not Cfg.autoBring or os.clock() - lastBring < Cfg.bringEvery then return end
        lastBring = os.clock()
        local n = Gather.bring(Cfg.bringKind, Cfg.bringTo)
        if n > 0 then Gather.status = string.format("Brought %d %s", n, Cfg.bringKind:lower()) end
    end
end

-- ── Survival: eating, warmth, night safety, kids, revives ────────────────────
do
    local function say(t, m, k) if World.notify then World.notify(t, m, k) end end
    local lastEat = 0
    function Survival.eatStep()
        if not Cfg.autoEat or os.clock() - lastEat < 2 then return end
        local h, max = G.hunger()
        if h / max * 100 >= Cfg.eatAt then return end
        lastEat = os.clock()
        local function edible(it)
            return Items.isFood(it) and (Cfg.eatRaw or not Items.isRaw(it))
        end
        -- cooked first, then the most filling
        local best, bestScore
        for _, it in G.items() do
            if Items.usable(it) and edible(it) then
                local p = G.itemPos(it)
                local d = p and U.dist(p) or math.huge
                local score = (tonumber(it:GetAttribute("RestoreHunger")) or 0) - d * 0.05
                if d <= Cfg.bringRange and (not bestScore or score > bestScore) then best, bestScore = it, score end
            end
        end
        if not best then
            for _, it in G.invItems() do
                if edible(it) then best = it; break end
            end
        end
        if not best then Survival.status = "Hungry · no food found"; return end
        if best.Parent == workspace:FindFirstChild("Items") and U.dist(G.itemPos(best)) > 12 then
            G.drag(best, Gather.destCF("Me", 1))
            task.wait(0.5)
        end
        if G.ok(G.invoke("RequestConsumeItem", best)) then
            Survival.eaten += 1
            Survival.status = "Ate " .. best.Name
        end
    end

    -- go warm up at the fire when it gets cold, then come back
    function Survival.warmStep()
        if not Cfg.autoWarm or G.temperature() > Cfg.warmAt or Job.busy then return end
        if U.dist(G.firePos()) < 20 then return end
        Job.run("Warming up", function()
            U.tp(G.firePos() + Vector3.new(8, 0, 0), 3)
            local t0 = os.clock()
            while os.clock() - t0 < 25 and G.temperature() < 85 and Cfg.autoWarm and not State.unloaded do task.wait(0.5) end
        end)
    end

    -- nights: stay within the camp light
    local wasNight = false
    function Survival.nightStep()
        local night = G.isNight()
        if not Cfg.nightSafe then wasNight = night; return end
        if night and not Job.busy and U.dist(G.firePos()) > 45 then
            if not wasNight then say("Night Safety", "Night fell. Heading back to camp.", "warn") end
            Move.cancel()
            U.tp(G.firePos() + Vector3.new(10, 0, 0), 3)
        end
        wasNight = night
    end

    -- lost kids: bag them, carry them to camp, drop them by the fire
    function Kids.rescue(kid)
        local bag = G.bag()
        if not bag then return false, "You need an item bag" end
        if not (kid and kid.Parent) or kid:GetAttribute("Rescued") then return false, "Already rescued" end
        local ok, why = false, nil
        Job.run("Rescuing " .. Npc.kidName(kid), function()
            local r = Npc.root(kid)
            if not r then why = "Kid isn't loaded"; return end
            U.tp(r.Position + Vector3.new(3, 0, 0), 2)
            task.wait(0.4)
            if not G.ok(G.invoke("RequestBagStoreItem", bag, kid)) then why = "Couldn't pick them up"; return end
            task.wait(0.3)
            U.tp(G.firePos() + Vector3.new(10, 0, 0), 3)
            task.wait(0.5)
            G.fire("RequestBagDropItem", bag, kid, true)
            ok = true
            Kids.rescued += 1
        end)
        return ok, why
    end
    function Kids.step()
        if not Cfg.autoRescue then Kids.status = "Off"; return end
        for _, k in Npc.kids() do
            local kr = Npc.root(k)
            if not k:GetAttribute("Rescued") and k:GetAttribute("CanBeBagged") and k.Parent == workspace:FindFirstChild("Characters")
                and kr and G.inBounds(kr.Position) then
                Kids.status = "Rescuing " .. Npc.kidName(k)
                local ok, why = Kids.rescue(k)
                Kids.status = ok and ("Rescued " .. Npc.kidName(k)) or ("Waiting: " .. tostring(why))
                if ok then say("Lost Kids", "Brought " .. Npc.kidName(k) .. " back to camp.", "success") end
                return
            end
        end
        Kids.status = "No lost kids loaded"
    end

    -- teammates' bodies (Interaction = "Revive")
    function Survival.reviveStep()
        if not Cfg.autoRevive then return end
        if not (G.has("Bandage") or G.has("MedKit")) then return end
        for _, root in { workspace:FindFirstChild("Items"), workspace:FindFirstChild("Characters") } do
            for _, b in (root and root:GetChildren() or {}) do
                if b:GetAttribute("Interaction") == "Revive" and G.root(b) and G.inBounds(G.itemPos(b)) then
                    Job.run("Reviving", function()
                        U.tp(G.itemPos(b) + Vector3.new(3, 0, 0), 2)
                        task.wait(0.4)
                        G.fire("RequestRevivePlayer", b)
                        task.wait(0.5)
                    end)
                    return
                end
            end
        end
    end

    local lastAgain = 0
    function Survival.playAgainStep()
        if not Cfg.autoPlayAgain or not workspace:GetAttribute("GameLost") or os.clock() - lastAgain < 5 then return end
        lastAgain = os.clock()
        G.fire("AcceptPlayAgain")
    end
end

-- ── Fishing ──────────────────────────────────────────────────────────────────
-- StartCatchTimer(rod, water part, spot) answers when a fish bites; ConfirmCatchItem lands it.
do
    local busy = false
    local function rod()
        local best, tier
        for _, it in G.invItems() do
            if it:GetAttribute("ToolName") == "Fishing Rod" and (not tier or (it:GetAttribute("ToolTier") or 1) > tier) then
                best, tier = it, it:GetAttribute("ToolTier") or 1
            end
        end
        return best
    end
    local function water()
        local me = U.hrp()
        if not me then return nil end
        local best, bestD
        for _, w in CS:GetTagged("Water") do
            if w:IsA("BasePart") and w:IsDescendantOf(workspace) then
                local lp = w.CFrame:PointToObjectSpace(me.Position)
                local s = w.Size / 2
                local clamped = Vector3.new(math.clamp(lp.X, -s.X, s.X), s.Y, math.clamp(lp.Z, -s.Z, s.Z))
                local wp = w.CFrame:PointToWorldSpace(clamped)
                local d = (wp - me.Position).Magnitude
                if d < 90 and (not bestD or d < bestD) then best, bestD = { part = w, pos = wp }, d end
            end
        end
        return best
    end
    function Fish.step()
        if not Cfg.autoFish then Fish.status = "Off"; return end
        if busy or not U.alive() then return end
        local r = rod()
        if not r then Fish.status = "You need a fishing rod"; return end
        local w = water()
        if not w then Fish.status = "Stand next to water"; return end
        busy = true
        task.spawn(function()
            G.equip(r)
            Fish.status = "Waiting for a bite"
            local res = G.invoke("StartCatchTimer", r, w.part, w.pos)
            if type(res) == "table" and res.Item and Cfg.autoFish then
                Fish.status = "Reeling in " .. tostring(res.Item)
                task.wait(Cfg.fishWait + math.random() * 0.6)
                G.fire("ConfirmCatchItem")
                Fish.caught += 1
                Fish.status = "Caught " .. tostring(res.Item)
                task.wait(1.2)
            else
                G.fire("EndCatching")
                task.wait(2)
            end
            busy = false
        end)
    end
end

-- ── World: places, crafting, machines ────────────────────────────────────────
do
    -- landmark positions live in ReplicatedStorage.Map (Position attribute), loaded or not
    function World.places()
        local out = {}
        if IS_FOREST then
            out[#out + 1] = { name = "Campfire", pos = G.firePos() + Vector3.new(8, 0, 0) }
            local sp = G.scrapPos()
            if sp then out[#out + 1] = { name = "Scrapper", pos = sp + Vector3.new(6, 0, 0) } end
            local bp = G.benchPos()
            if bp then out[#out + 1] = { name = "Crafting Bench", pos = bp + Vector3.new(6, 0, 0) } end
        end
        local mf = RS:FindFirstChild("Map")
        local list = {}
        for _, c in (mf and mf:GetChildren() or {}) do
            local p = c:GetAttribute("Position")
            if typeof(p) == "Vector3" then list[#list + 1] = { name = c.Name, pos = p } end
        end
        table.sort(list, function(a, b) return a.name < b.name end)
        for _, e in list do out[#out + 1] = e end
        for _, tag in { "PeltTrader", "StrangeTrader", "ToolTrader", "AlienTrader" } do
            for _, t in CS:GetTagged(tag) do
                if t:IsDescendantOf(workspace) then out[#out + 1] = { name = (tag:gsub("(%l)(%u)", "%1 %2")), pos = t:GetPivot().Position } end
            end
        end
        return out
    end
    function World.go(pos)
        if not pos then return false end
        local hrp = U.hrp()
        if not hrp then return false end
        -- far trips are instant; the game's own teleporters and capsules move you just as fast
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true
    end

    function World.stronghold()
        for _, s in CS:GetTagged("Stronghold") do
            if s:IsDescendantOf(workspace) then
                local f = s:FindFirstChild("Functional")
                local open = f and tonumber(f:GetAttribute("OpenTime"))
                return s, open and (open - workspace:GetServerTimeNow()) or nil
            end
        end
        return nil, nil
    end

    -- crafting bench recipes, by tier
    function World.recipes()
        local out = {}
        local db = G.try(function() return require(RS.Databases.CraftingDatabase) end)
        for tier, list in (db and db.PossibleBlueprints or {}) do
            for _, e in list do
                if type(e) == "table" and type(e.Name) == "string" then out[#out + 1] = { name = e.Name, tier = tier, entry = e } end
            end
        end
        return out
    end
    function World.benchTier()
        local ct = RS:FindFirstChild("Crafting Table")
        return tonumber(ct and ct:GetAttribute("CraftingTableTier")) or 1
    end
    function World.materials()
        local c = G.camp()
        if not c then return "—" end
        return string.format("Wood %d  ·  Scrap %d  ·  Gems %d", c:GetAttribute("TotalWood") or 0, c:GetAttribute("TotalScrap") or 0, c:GetAttribute("TotalGems") or 0)
    end
    function World.craft(name)
        local res = G.invoke("CraftItem", name)
        return res ~= nil and res ~= false and (type(res) ~= "table" or res.Success ~= false)
    end
    local lastBench = 0
    function World.benchStep()
        if not Cfg.autoBench or os.clock() - lastBench < 15 then return end
        lastBench = os.clock()
        local nextTier = World.benchTier() + 1
        if nextTier > 5 then return end
        if World.craft("Crafting Bench " .. nextTier) and World.notify then
            World.notify("Crafting", "Upgraded the crafting bench to tier " .. nextTier .. ".", "success")
        end
    end
    function World.skipNight()
        for _, m in CS:GetTagged("NightSkipMachine") do
            if m:IsDescendantOf(workspace) then G.fire("RequestActivateNightSkipMachine", m); return true end
        end
        return false
    end

    function World.shutdown() end
end

-- ── Lobby: join a match, class, daily rewards, codes ─────────────────────────
do
    local function say(t, m, k) if World.notify then World.notify(t, m, k) end end
    function Lobby.classes()
        local out = {}
        local cp = LP:FindFirstChild("ClassProgress")
        for _, c in (cp and cp:GetChildren() or {}) do out[#out + 1] = c.Name end
        table.sort(out)
        if #out == 0 then out = { "(no classes owned)" } end
        return out
    end
    function Lobby.equippedClass()
        local cp = LP:FindFirstChild("ClassProgress")
        for _, c in (cp and cp:GetChildren() or {}) do
            if c:GetAttribute("Equipped") then return c.Name end
        end
        return nil
    end
    function Lobby.equip(name)
        if not name or name == "" or name:sub(1, 1) == "(" then return false end
        return G.fire("UpdateEquipped", name)
    end

    function Lobby.claimDaily()
        local n = 0
        local dq = LP:FindFirstChild("DailyQuests")
        for _, q in (dq and dq:GetChildren() or {}) do
            if q:GetAttribute("Completed") and not q:GetAttribute("Rewarded") then
                local slot = q:GetAttribute("QuestNumber")
                if slot and G.ok(G.invoke("RequestClaimDailyRequestReward", slot)) then n += 1 end
                task.wait(0.5)
            end
        end
        local ub = LP:FindFirstChild("UnclaimedBadges")
        for _, b in (ub and ub:GetChildren() or {}) do
            if b:IsA("BoolValue") and b.Value then G.fire("RequestClaimBadgeDiamonds", tonumber(b.Name) or b.Name); n += 1 end
        end
        return n
    end
    function Lobby.redeem(code)
        local r = G.remote("RequestInputCode")
        if not r then return false, "Codes aren't available here" end
        local ok, msg, kind = pcall(r.InvokeServer, r, code, false)
        if not ok then return false, tostring(msg) end
        return kind == "Success", tostring(msg or "")
    end

    -- pads are workspace.Teleporter1..N; stepping on one sends "Add", the party leader confirms with "Chosen"
    local function pads()
        local out = {}
        for _, c in workspace:GetChildren() do
            local n = tonumber(c.Name:match("^Teleporter(%d+)$"))
            local part = n and c:FindFirstChild("EnterPart")
            if part then out[#out + 1] = { n = n, part = part } end
        end
        table.sort(out, function(a, b) return a.n < b.n end)
        return out
    end
    local function extras()
        local e = {}
        if Cfg.joinMode == "Hardcore" then e.Hardcore = "On" end
        if Cfg.joinBiome ~= "Random" then e.Biome = Cfg.joinBiome end
        return next(e) and e or nil
    end
    local joining = false
    function Lobby.join()
        if joining then return end
        joining = true
        for _, p in pads() do
            if not Cfg.autoJoin or State.unloaded then break end
            Lobby.status = "Joining teleporter " .. p.n
            U.tp(p.part.Position, 1)
            G.fire("TeleportEvent", "Add", p.n)
            task.wait(1.5)
            G.fire("TeleportEvent", "Chosen", nil, Cfg.joinSize, extras())
            local t0 = os.clock()
            while os.clock() - t0 < 25 and Cfg.autoJoin and not State.unloaded do
                Lobby.status = string.format("Waiting on teleporter %d (%ds)", p.n, math.floor(25 - (os.clock() - t0)))
                task.wait(1)
            end
            G.fire("TeleportEvent", "Remove")
            task.wait(1)
        end
        joining = false
    end
    function Lobby.step()
        if not IS_LOBBY then return end
        if Cfg.autoClass and Cfg.classPick ~= "" and Lobby.equippedClass() ~= Cfg.classPick then Lobby.equip(Cfg.classPick) end
        if Cfg.autoDaily then Lobby.claimDaily() end
        if Cfg.autoJoin and not joining then task.spawn(Lobby.join) end
        if not Cfg.autoJoin then Lobby.status = "Off" end
    end
end

-- ── Hover: hold above enemies at their height, close in, weave only vs cultists ──
-- Position is driven directly each frame so the height follows the enemy under us.
do
    local center, posY, lastThreat, scanAt = nil, nil, -1e9, 0
    local radius, radiusGoal, angle, dir, flipAt = 0, 0, 0, 1, 0
    local tops = setmetatable({}, { __mode = "k" })
    local LINGER = 2.5

    local function threat(m)
        if not (m:IsA("Model") and m:HasTag("NPC")) or Npc.passive(m) then return false end
        return Npc.attackable(m) and G.inBounds(Npc.root(m).Position, 4)
    end
    -- root to the top of the model, measured once per mob
    local function topOf(m)
        local t = tops[m]
        if not t then
            local h = tonumber(m:GetAttribute("ModelHeight"))
            if not h then
                local ok, s = pcall(m.GetExtentsSize, m)
                h = ok and s.Y or 6
            end
            t = math.clamp(h / 2, 1, 20)
            tops[m] = t
        end
        return t
    end
    -- nearest cultist wins over everything else
    local function scan(pos)
        local n, mob, mobD, cult, cultD = 0, nil, nil, nil, nil
        for _, m in G.characters() do
            if threat(m) then
                local p = Npc.root(m).Position
                local d = Vector3.new(p.X - pos.X, 0, p.Z - pos.Z).Magnitude
                if d <= Cfg.hoverRange then
                    n += 1
                    if Npc.isCultist(m) then
                        if not cultD or d < cultD then cult, cultD = m, d end
                    elseif not mobD or d < mobD then
                        mob, mobD = m, d
                    end
                end
            end
        end
        return n, cult or mob
    end

    local function stop()
        local hrp = U.hrp()
        if hrp and Hover.active then hrp.AssemblyLinearVelocity = Vector3.zero end
        Hover.active, Hover.target, center, posY = false, nil, nil, nil
        Move.setNoclip("hover", false)
    end
    local function start()
        Hover.active, center, posY = true, nil, nil
        Move.setNoclip("hover", true)
        if Move.moving then Move.cancel() end
    end
    Hover.stop = stop
    function Hover.shutdown() Cfg.hoverOn = false; stop() end

    track(RunService.Heartbeat:Connect(function(dt)
        if State.unloaded then return end
        local hum, hrp = U.hum(), U.hrp()
        if not (Cfg.hoverOn and hum and hrp and hum.Health > 0) then
            if Hover.active then stop() end
            Hover.status = Cfg.hoverOn and "Waiting to respawn" or "Off"
            return
        end
        local now = os.clock()
        if now - scanAt > 0.2 then
            scanAt = now
            local n, t = scan(hrp.Position)
            Hover.threats = n
            if t then Hover.target = t; lastThreat = now end
        end
        local want = now - lastThreat < LINGER
        if want and not Hover.active then start() elseif not want and Hover.active then stop() end
        if not Hover.active then Hover.status = "Ground · no enemies close"; return end
        -- teleports and travel move us themselves; pick back up from wherever they leave us
        if Job.busy or Move.moving then center, posY = nil, nil; return end

        local p = hrp.Position
        local flatP = Vector3.new(p.X, 0, p.Z)
        if not center or (flatP - center).Magnitude > radius + 20 then
            center, posY, radius = flatP, p.Y, 0
        end
        local t = Hover.target
        local tr = t and t.Parent and threat(t) and Npc.root(t)
        local cultist = tr and Npc.isCultist(t)

        -- weave only while a cultist is the target; everything else gets a straight hold overhead
        if cultist then
            if now > flipAt then
                if math.random() < 0.6 then dir = -dir end
                flipAt = now + 0.6 + math.random() * 1.4
                radiusGoal = Cfg.hoverRadius * (0.6 + math.random() * 0.8)
            end
        else
            radiusGoal = 0
        end

        local wantY = posY
        if tr then
            local goal = Vector3.new(tr.Position.X, 0, tr.Position.Z)
            local gap = goal - center
            local chase = math.max(Cfg.hoverSpeed * 1.4, gap.Magnitude * 3) * dt
            center = gap.Magnitude <= chase and goal or center + gap.Unit * chase
            wantY = tr.Position.Y + topOf(t) + Cfg.hoverHeight
            Hover.status = string.format("%s %s · %d studs · %d close", cultist and "Dodging over" or "Above", t.Name,
                math.floor((goal - flatP).Magnitude), Hover.threats)
        else
            Hover.status = "Holding · watching for enemies"
        end
        local climb = math.max(Cfg.hoverSpeed, 30) * dt
        posY += math.clamp(wantY - posY, -climb, climb)

        radius += (radiusGoal - radius) * math.min(1, dt * 3)
        if radius > 0.3 then
            angle += dir * Cfg.hoverSpeed * (0.85 + math.random() * 0.3) / math.max(radius, 2) * dt
        end
        local goal = Vector3.new(center.X + math.cos(angle) * radius, posY, center.Z + math.sin(angle) * radius)
        local edge = G.mapRange() - 3
        local flatGoal = Vector3.new(goal.X, 0, goal.Z)
        if flatGoal.Magnitude > edge then
            flatGoal = flatGoal.Unit * edge
            goal = Vector3.new(flatGoal.X, posY, flatGoal.Z)
        end
        local step = goal - p
        local look = tr and Vector3.new(tr.Position.X, goal.Y, tr.Position.Z) or (goal + Vector3.new(step.X, 0, step.Z))
        if (look - goal).Magnitude < 0.1 then look = goal + hrp.CFrame.LookVector * Vector3.new(1, 0, 1) end
        if (look - goal).Magnitude < 0.1 then look = goal + Vector3.xAxis end
        hrp.CFrame = CFrame.lookAt(goal, look)
        local v = step / math.max(dt, 1 / 240)
        hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    end))
end

