    end
    local function S(box, flag, text, min, max, o)
        o = o or {}
        return box:AddSlider(flag, { Text = text, Default = Cfg[flag], Min = min, Max = max, Rounding = o.round or 0,
            Suffix = o.suffix, Tooltip = o.tip, Callback = o.cb or function(v) Cfg[flag] = v end })
    end
    local function D(box, flag, text, values, o)
        o = o or {}
        return box:AddDropdown(flag, { Text = text, Values = values, Default = o.default or Cfg[flag], Tooltip = o.tip,
            Searchable = o.search, AllowNull = o.null, Callback = o.cb or function(v) Cfg[flag] = v end })
    end
    local function bind(flag, text, default)
        Toggles[flag]:AddKeyPicker(flag .. "Key", { Default = default or "None", SyncToggleState = true, Mode = "Toggle", Text = text })
    end
