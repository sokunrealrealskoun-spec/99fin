    local function corner(o, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = o end

    -- ── console ──
    local console
    local function lineColor(line)
        if line:find("%[error%]") then return Color3.fromRGB(255, 110, 120) end
        if line:find("%[warn%]") then return Color3.fromRGB(255, 200, 90) end
        return Color3.fromRGB(215, 218, 235)
    end
    function Meta.log(text)
        local line = os.date("%H:%M:%S") .. "  " .. tostring(text)
        Meta.logs[#Meta.logs + 1] = line
        if #Meta.logs > 300 then table.remove(Meta.logs, 1) end
        if console then console.add(line) end
    end
    track(LogService.MessageOut:Connect(function(msg, kind)
        local tag = kind == Enum.MessageType.MessageError and "[error] " or (kind == Enum.MessageType.MessageWarning and "[warn] " or "")
        Meta.log(tag .. msg)
    end))
    local function draggable(handle, frame)
        local dragging, start, startPos
        handle.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging, start, startPos = true, i.Position, frame.Position end
        end)
        track(UIS.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                local d = i.Position - start
                frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        track(UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end))
    end
    function Meta.setConsole(on)
        if not on then
            if console then console.frame:Destroy(); console = nil end
            return
        end
        if console then return end
        local th = TH
        local f = Instance.new("Frame")
        f.Size = UDim2.fromOffset(480, 270)
        f.Position = UDim2.new(0, 20, 1, -310)
        f.BackgroundColor3 = th.BG
        f.BorderSizePixel = 0
        f.Active = true
        f.Parent = layer()
        corner(f, 8)
        local st = Instance.new("UIStroke"); st.Color = th.Accent; st.Parent = f
        local bar = Instance.new("TextLabel")
        bar.Size = UDim2.new(1, -120, 0, 26)
        bar.Position = UDim2.fromOffset(10, 0)
        bar.BackgroundTransparency = 1
        bar.Text = "Console"
        bar.Font = Enum.Font.GothamBold
        bar.TextSize = 13
        bar.TextColor3 = th.Text
        bar.TextXAlignment = Enum.TextXAlignment.Left
        bar.Active = true
        bar.Parent = f
        draggable(bar, f)
        local sf = Instance.new("ScrollingFrame")
        sf.Size = UDim2.new(1, -12, 1, -34)
        sf.Position = UDim2.fromOffset(6, 28)
        sf.BackgroundColor3 = th.Panel
        sf.BorderSizePixel = 0
        sf.ScrollBarThickness = 4
        sf.ScrollBarImageColor3 = th.Accent
        sf.CanvasSize = UDim2.new()
        sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
        sf.Parent = f
        corner(sf, 6)
        local lay = Instance.new("UIListLayout"); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Parent = sf
        local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 6); pad.PaddingTop = UDim.new(0, 4); pad.Parent = sf
        local n = 0
        local function add(line)
            n += 1
            local l = Instance.new("TextLabel")
            l.BackgroundTransparency = 1
            l.Size = UDim2.new(1, -10, 0, 0)
            l.AutomaticSize = Enum.AutomaticSize.Y
