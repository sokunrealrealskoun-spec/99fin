-- ── Player: movement + utility ───────────────────────────────────────────────
-- The game's Humanoid handler rewrites WalkSpeed / JumpPower every 0.075s, so overrides are
-- reapplied every physics step. While it wants you slowed (stun, block, ragdoll: speed <= 4,
-- jump 0) the game's value is left alone.
local Player = { notify = nil, safe = nil, deathAt = nil, trail = {} }
do
    local VU = game:GetService("VirtualUser")
    local gameWS, gameJP, hooked = 16, 50, nil
    local setWS, setJP = nil, nil -- last values we wrote, so our own writes aren't mistaken for the game's
    local lastJump, lastVoid, lastHop = 0, 0, 0

    local function say(t, m, k) if Player.notify then Player.notify(t, m, k) end end

    local function hook(hum)
        if hooked == hum then return end
        hooked = hum
        gameWS, gameJP, setWS, setJP = hum.WalkSpeed, hum.JumpPower, nil, nil
        track(hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if hum.WalkSpeed ~= setWS then gameWS = hum.WalkSpeed end
        end))
        track(hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if hum.JumpPower ~= setJP then gameJP = hum.JumpPower end
        end))
        track(hum.Died:Connect(function()
            local hrp = U.hrp()
            if hrp then Player.deathAt = hrp.CFrame end
        end))
    end

    local function flyDir()
        if Cfg.freecam or UIS:GetFocusedTextBox() then return Vector3.zero end
        local cf = workspace.CurrentCamera.CFrame
        local v = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then v += cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then v -= cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then v += cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then v -= cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then v += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then v -= Vector3.yAxis end
        return v.Magnitude > 0 and v.Unit or v
    end

    track(RunService.Stepped:Connect(function(_, dt)
        if State.unloaded then return end
        local hum, hrp = U.hum(), U.hrp()
        if not (hum and hrp) or hum.Health <= 0 then return end
        hook(hum)
        -- speed: stuns (0) always win; blocking / slowed (<= 4) only lifted by No Slowdowns
        local ws
        if gameWS > 0 then
            if Cfg.speedOn and (gameWS > 4 or Cfg.noSlow) then
                ws = Cfg.walkSpeed
            elseif Cfg.noSlow then
                local base = Tweak.running() and 25 or 16
                if gameWS < base then ws = base end
            end
        end
        if ws and hum.WalkSpeed ~= ws then setWS = ws; hum.WalkSpeed = ws end
        -- jump: 0 means the game locked jumping; Ignore Jump Lock lifts it unless you're stunned
        local jp
        if gameJP > 0 then
            if Cfg.jumpOn then jp = Cfg.jumpPower end
        elseif Cfg.ignoreJumpLock and not Tweak.stunned() then
            jp = Cfg.jumpOn and Cfg.jumpPower or 50
        end
        if jp and hum.JumpPower ~= jp then
            hum.UseJumpPower = true
            setJP = jp
            hum.JumpPower = jp
        end
        -- jump directly: the game's controls clear Humanoid.Jump every frame
        if Cfg.bhop and hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude > 0
            and os.clock() - lastHop > 0.2 and not UIS:GetFocusedTextBox() then
            lastHop = os.clock()
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
        if Cfg.fly and not Farm.locking then
            -- half a frame of gravity up front so hovering doesn't sink
            hrp.AssemblyLinearVelocity = flyDir() * Cfg.flySpeed + Vector3.yAxis * (workspace.Gravity * dt * 0.5)
        end
        if Cfg.antiFling then
            for _, p in Players:GetPlayers() do
                local c = p ~= LP and p.Character
                if c then
                    for _, d in c:GetChildren() do
                        if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
                    end
                end
            end
            if hrp.AssemblyAngularVelocity.Magnitude > 40 then hrp.AssemblyAngularVelocity = Vector3.zero end
        end
    end))

    local acc = 0
    track(RunService.Heartbeat:Connect(function(dt)
        if State.unloaded then return end
        local hum, hrp = U.hum(), U.hrp()
        if not (hum and hrp) or hum.Health <= 0 then return end
        local grounded = hum.FloorMaterial ~= Enum.Material.Air
        local voidY = workspace.FallenPartsDestroyHeight
        if Cfg.antiVoid and Player.safe and hrp.Position.Y < voidY + 40 then
            -- farming keeps you off the ground, so the last grounded spot can be far behind;
            -- the target's last position puts you right back at the fight
            local fight = Farm.on and Farm.lastPos
            Farm.voidAt = os.clock()
            -- a travel loop that was running keeps chasing from the old spot; restart it from here
            if Farm.on and not Farm.locking then Move.cancel() end
            if fight and fight.Y > voidY + 60 then
                hrp.CFrame = CFrame.new(fight + Vector3.new(0, 6, 0))
            else
                hrp.CFrame = Player.safe + Vector3.new(0, 4, 0)
            end
            hrp.AssemblyLinearVelocity = Vector3.zero
            if os.clock() - lastVoid > 5 then
                lastVoid = os.clock()
                say("Anti Void", "Caught you falling into the void.", "warn")
            end
        end
        acc += dt
        if acc >= 0.25 then
            acc = 0
            if grounded then Player.safe = hrp.CFrame end
            local tr = Player.trail
            tr[#tr + 1] = hrp.CFrame
            if #tr > 64 then table.remove(tr, 1) end
        end
    end))

    track(UIS.JumpRequest:Connect(function()
        if not Cfg.infJump or os.clock() - lastJump < 0.2 then return end
        local hum = U.hum()
        if hum and hum.Health > 0 and hum.FloorMaterial == Enum.Material.Air then
            lastJump = os.clock()
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end))

    function Player.setFly(on)
        Cfg.fly = on
    end

    local BODY = { "HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso", "Head" }
    function Player.setNoclip(on)
        Cfg.noclipPlayer = on
        Move.setNoclip("player", on)
        if not on and next(Move.noclipFor) == nil then
            local c = LP.Character
            for _, n in BODY do
                local p = c and c:FindFirstChild(n)
                if p and p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end

    function Player.rewind()
        local tr, hrp = Player.trail, U.hrp()
        local back = math.floor(Cfg.rewindSec * 4)
        local cf = tr[math.max(1, #tr - back)]
        if not (cf and hrp) then return end
        hrp.CFrame = cf
        hrp.AssemblyLinearVelocity = Vector3.zero
        -- drop the skipped part so pressing again goes further back
        for _ = 1, math.min(back, #tr - 1) do table.remove(tr) end
        say("Rewind", string.format("Went back %d seconds.", Cfg.rewindSec), "default")
    end

    function Player.reset()
        local hum = U.hum(); if not hum then return end
        hum.Health = 0
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
    end

    local function mouseHit()
        local m = UIS:GetMouseLocation()
        local ray = workspace.CurrentCamera:ViewportPointToRay(m.X, m.Y)
        local r = workspace:Raycast(ray.Origin, ray.Direction * 2000, Move.params())
        return r and r.Position
    end

    track(UIS.InputBegan:Connect(function(input, gp)
        if State.unloaded then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if Cfg.clickAction == "Off" or gp or not UIS:IsKeyDown(Enum.KeyCode.LeftControl) or U.overOurGui() then return end
            local pos, hrp, hum = mouseHit(), U.hrp(), U.hum()
            if not (pos and hrp and hum) then return end
            if Cfg.clickAction == "Teleport" then
                hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) * hrp.CFrame.Rotation
                hrp.AssemblyLinearVelocity = Vector3.zero
            else
                hum:MoveTo(pos)
            end
            return
        end
        if gp or UIS:GetFocusedTextBox() or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local k = input.KeyCode
        if k == Cfg.flyKey then
            Player.setFly(not Cfg.fly)
            say("Flight", Cfg.fly and "On" or "Off", "default")
        elseif k == Cfg.noclipKey then
            Player.setNoclip(not Cfg.noclipPlayer)
            say("No-Clip", Cfg.noclipPlayer and "On" or "Off", "default")
        elseif k == Cfg.rewindKey then
            Player.rewind()
        elseif k == Cfg.freecamKey then
            View.setFreecam(not Cfg.freecam)
        end
    end))

    track(LP.CharacterAdded:Connect(function(c)
        local at = Player.deathAt
        Player.deathAt, Player.safe, Player.trail = nil, nil, {}
        if not (Cfg.tpBackOnDeath and at) then return end
        local hrp = c:WaitForChild("HumanoidRootPart", 15)
        if not hrp then return end
        task.wait(1.5)
        if hrp.Parent and Cfg.tpBackOnDeath then
            hrp.CFrame = at + Vector3.new(0, 3, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
            say("TP Back On Death", "Returned to where you died.", "default")
        end
    end))

    track(LP.Idled:Connect(function()
        if not Cfg.antiAfk then return end
        pcall(function()
            VU:CaptureController()
            VU:ClickButton2(Vector2.new())
        end)
    end))

    function Player.shutdown()
        Cfg.speedOn, Cfg.jumpOn, Cfg.fly, Cfg.infJump, Cfg.bhop = false, false, false, false, false
        Cfg.antiVoid, Cfg.antiFling, Cfg.tpBackOnDeath, Cfg.clickAction = false, false, false, "Off"
        Player.setNoclip(false)
    end
end

-- ── Server + players: hop, rejoin, alerts, spectate, follow, chat, webhook ───
-- Hops and joins use the public server list with TeleportService.
-- Staff = rank in the game's group (175661976) or a staff-sounding role.
local Server = { notify = nil, status = "Idle", servers = {}, chat = {}, staff = {}, startedAt = os.clock(),
                 lastInput = os.clock(), leaving = false, spectating = nil, following = nil, stopAll = nil }
do
    local TPS = game:GetService("TeleportService")
    local Http = game:GetService("HttpService")
    local GuiService = game:GetService("GuiService")
    local TCS = game:GetService("TextChatService")
    local STAFF_GROUP = game.CreatorType == Enum.CreatorType.Group and game.CreatorId or 0
    local CHAT_FILE = "Zenith99Nights/chatlog.txt"

    local function say(t, m, k) if Server.notify then Server.notify(t, m, k) end end
    local cache = {}
    local function mod(key, pathFn)
        if cache[key] == nil then
            local ok, m = pcall(function() return require(pathFn()) end)
            cache[key] = (ok and type(m) == "table") and m or false
        end
        return cache[key] or nil
    end
    local function teleporter() return mod("tp", function() return RS.CAM.Client.Modules.Teleporter end) end
    local function browser() return mod("sb", function() return RS.CAM.Client.Controllers.ServerBrowserController end) end
    local function httpFn() return request or http_request or (syn and syn.request) or (http and http.request) end

    function Server.regions()
        local out = { "Any" }
        local sb = browser()
        local ok, list = pcall(function() return sb and sb.Regions() end)
        for _, r in (ok and type(list) == "table") and list or { "NA-WEST", "NA-CENTRAL", "NA-EAST", "SA", "EU", "AF", "AS", "OCE" } do
            out[#out + 1] = r
        end
        return out
    end

    local queued = false
    local function queueSelf()
        local LOADER = Cfg.rerunScript
        if queued or not Cfg.rerunOnHop or type(LOADER) ~= "string" or LOADER == "" then return end
        local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        if q and pcall(q, LOADER) then queued = true end
    end
    Server.queueSelf = queueSelf
    -- catches teleports the game starts itself (travel to other places, menu, kicks to lobby)
    track(LP.OnTeleport:Connect(function(state)
        if state == Enum.TeleportState.Started or state == Enum.TeleportState.InProgress then
            if Server.beforeTeleport then pcall(Server.beforeTeleport) end
            queueSelf()
        end
    end))

    function Server.fmtTime(sec)
        sec = math.max(0, math.floor(sec))
        local h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
        if h > 0 then return string.format("%dh %02dm", h, m) end
        return string.format("%dm %02ds", m, s)
    end

    -- ── server list ──
    local function apiServers()
        local f = httpFn(); if not f then return nil end
        local ok, r = pcall(f, { Url = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId), Method = "GET" })
        if not (ok and r and r.Body) then return nil end
        local ok2, data = pcall(Http.JSONDecode, Http, r.Body)
        if not (ok2 and type(data) == "table" and type(data.data) == "table") then return nil end
        local out = {}
        for _, s in data.data do
            if type(s.id) == "string" then
                out[#out + 1] = { Name = "Server " .. s.id:sub(1, 8), JobId = s.id, PlaceId = game.PlaceId,
                                  Players = s.playing or 0, MaxPlayers = s.maxPlayers or 0, api = true }
            end
        end
        return out
    end

    function Server.fetch(region)
        local sb = browser()
        if sb and sb.Browse and sb.Updated then
            local result
            local c1 = sb.Updated:Connect(function(st)
                if type(st) == "table" and st.Kind == "Browse" and type(st.Servers) == "table" then result = st.Servers end
            end)
            local c2 = sb.Failed and sb.Failed:Connect(function() if result == nil then result = false end end)
            pcall(sb.Browse, game.PlaceId, (region and region ~= "Any") and region or nil)
            local t0 = os.clock()
            while result == nil and os.clock() - t0 < 8 do task.wait(0.1) end
            pcall(function() c1:Disconnect() end)
            if c2 then pcall(function() c2:Disconnect() end) end
            if type(result) == "table" then Server.servers = result; return result end
        end
        local list = apiServers() or {}
        Server.servers = list
        return list
    end

    function Server.describe(s)
        local up = ""
        if type(s.StartTime) == "number" then up = "  " .. Server.fmtTime(workspace:GetServerTimeNow() - s.StartTime) end
        local friends = (type(s.Friends) == "table" and #s.Friends > 0) and ("  ♥" .. #s.Friends) or ""
        return string.format("%s  %d/%d  %s%s%s", tostring(s.Name), tonumber(s.Players) or 0, tonumber(s.MaxPlayers) or 0,
            tostring(s.Region or ""), up, friends)
    end

    local function isCurrent(s)
        return s.JobId == game.JobId or (s.Name ~= nil and s.Name == workspace:GetAttribute("ServerName"))
    end

    function Server.join(s)
        if isCurrent(s) then return false, "You're already in this server" end
        queueSelf()
        if not s.api then
            local sb = browser()
            if sb and sb.Join then
                local ok, a, b = pcall(sb.Join, s)
                if ok and a then return true end
                if ok and b then return false, tostring(b) end
            end
        end
        local ok, err = pcall(TPS.TeleportToPlaceInstance, TPS, s.PlaceId or game.PlaceId, s.JobId, LP)
        return ok, ok and nil or tostring(err)
    end

    local hopping = false
    function Server.hop()
        if hopping then return end
        hopping = true
        Server.status = "Finding a server..."
        local pool = {}
        for _, s in Server.fetch(Cfg.hopRegion) do
            local max = tonumber(s.MaxPlayers) or 0
            if not isCurrent(s) and (max == 0 or (tonumber(s.Players) or 0) < max) then pool[#pool + 1] = s end
        end
        if Cfg.hopPrefer == "Fewest Players" then
            table.sort(pool, function(a, b) return (a.Players or 0) < (b.Players or 0) end)
        elseif Cfg.hopPrefer == "Most Players" then
            table.sort(pool, function(a, b) return (a.Players or 0) > (b.Players or 0) end)
        else
            for i = #pool, 2, -1 do local j = math.random(i); pool[i], pool[j] = pool[j], pool[i] end
        end
        if #pool == 0 then Server.status = "No other servers found"; say("Server Hop", "No other servers to join.", "warn") end
        for i = 1, math.min(#pool, 5) do
            Server.status = "Joining " .. tostring(pool[i].Name)
            local ok, err = Server.join(pool[i])
            if ok then
                task.wait(15) -- still here after this = the teleport didn't go through
                Server.status = "Teleport didn't go through, trying another"
            else
                Server.status = "Couldn't join: " .. tostring(err)
                task.wait(1)
            end
        end
        hopping = false
    end

    function Server.rejoin()
        Server.status = "Rejoining..."
        queueSelf()
        local tp = teleporter()
        if tp then
            local ok, a = pcall(tp.Request, { placeId = game.PlaceId, jobId = game.JobId }, { Title = "Rejoining" })
            if ok and a then return end
        end
        if #Players:GetPlayers() <= 1 then
            pcall(TPS.Teleport, TPS, game.PlaceId, LP)
        else
            pcall(TPS.TeleportToPlaceInstance, TPS, game.PlaceId, game.JobId, LP)
        end
    end

    local function tpRequest(opts, title)
        local tp = teleporter()
        if not tp then return false, "Teleporting isn't available here" end
        queueSelf()
        local ok, a, b = pcall(tp.Request, opts, { Title = title })
        if not ok then return false, tostring(a) end
        return a == true, b
    end
    function Server.joinPlayer(name)
        if name == "" then return false, "Type a username first" end
        return tpRequest({ followName = name }, "Joining " .. name)
    end
    function Server.joinPrivate(owner)
        if owner == "" then return false, "Type the owner's username first" end
        return tpRequest({ placeId = game.PlaceId, privateOwner = owner }, "Private Server")
    end

    function Server.leave(why)
        Server.leaving = true
        pcall(function() LP:Kick("ZRHUB: " .. tostring(why)) end)
    end

    -- ── webhook ──
    local function level()
        if IS_LOBBY then return "In lobby" end
        return string.format("Day %d (%s)", G.day(), G.isNight() and "night" or "day")
    end
    function Server.webhook(title, detail)
        local url = Cfg.webhookUrl
        if type(url) ~= "string" or not url:match("^https://") then return false, "Paste a webhook URL first" end
        local f = httpFn()
        if not f then return false, "Your executor can't send web requests" end
        local function field(n, v) return { name = n, value = tostring(v ~= "" and v or "—"), inline = true } end
        local embed = {
            title = title,
            description = detail,
            color = 0x8B5CF6,
            fields = {
                field("Player", "||" .. LP.Name .. "||"),
                field("Day", level()),
                field("Server", string.format("%s (%d players)", tostring(workspace:GetAttribute("ServerName") or "?"), #Players:GetPlayers())),
                field("Session", Server.fmtTime(os.clock() - Server.startedAt)),
                field("Campfire", IS_FOREST and (math.floor((G.fuel()) / select(2, G.fuel()) * 100) .. "%") or "-"),
                field("Kills", Combat.hits .. " hits · " .. Combat.treeHits .. " tree hits"),
                field("Gathered", Gather.brought .. " brought · " .. Gather.burned .. " burned"),
                field("Kids Rescued", Kids.rescued),
            },
            footer = { text = "ZRHUB · 99 Nights" },
            timestamp = DateTime.now():ToIsoDate(),
        }
        local ok, r = pcall(f, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" },
                                 Body = Http:JSONEncode({ embeds = { embed } }) })
        if not ok or not r then return false, "Request failed" end
        local code = tonumber(r.StatusCode) or 0
        if code >= 200 and code < 300 then return true end
        return false, "Discord answered " .. code
    end

    -- ── alerts / staff ──
    local function act(action, title, why)
        if action == "Off" then return end
        say(title, why, "warn")
        if Cfg.webhookOn then task.spawn(Server.webhook, title, why) end
        if action == "Server Hop" then
            if Server.stopAll then pcall(Server.stopAll) end
            task.spawn(Server.hop)
        elseif action == "Leave Game" then
            if Server.stopAll then pcall(Server.stopAll) end
            Server.leave(title .. ": " .. why)
        end
    end

    local roles = {}
    local WORDS = { "mod", "admin", "staff", "dev", "owner", "manager", "helper", "tester", "support" }
    local function staffRole(p)
        local r = roles[p.UserId]
        if not r then
            local ok, rank = pcall(p.GetRankInGroup, p, STAFF_GROUP)
            local ok2, role = pcall(p.GetRoleInGroup, p, STAFF_GROUP)
            r = { rank = ok and tonumber(rank) or 0, role = ok2 and tostring(role) or "" }
            roles[p.UserId] = r
        end
        if r.rank <= 0 then return nil end
        local staff = r.rank >= Cfg.modRank
        if not staff then
            local low = r.role:lower()
            for _, w in WORDS do if low:find(w, 1, true) then staff = true; break end end
        end
        return staff and string.format("%s, rank %d", r.role, r.rank) or nil
    end
    function Server.checkStaff(p)
        if p == LP or not Cfg.modSafety then return end
        local role = staffRole(p)
        if role and not Server.staff[p] then
            Server.staff[p] = role
            if Cfg.modStopFarm and Server.stopAll then pcall(Server.stopAll) end
            act(Cfg.modAction, "Staff in your server", p.Name .. " (" .. role .. ")")
        end
    end
    function Server.scanStaff()
        for _, p in Players:GetPlayers() do task.spawn(Server.checkStaff, p) end
    end

    local friends = {}
    local function isFriend(p)
        if friends[p.UserId] == nil then
            local ok, v = pcall(LP.IsFriendsWith, LP, p.UserId)
            friends[p.UserId] = ok and v == true
        end
        return friends[p.UserId]
    end

    track(Players.PlayerAdded:Connect(function(p)
        if Cfg.joinAlerts then say("Player joined", p.Name, "default") end
        task.spawn(Server.checkStaff, p)
    end))
    track(Players.PlayerRemoving:Connect(function(p)
        if Cfg.joinAlerts and p ~= LP then say("Player left", p.Name, "default") end
        Server.staff[p] = nil
        if Server.spectating == p then Server.spectate(nil) end
        if Server.following == p then Server.following = nil end
    end))
    task.defer(Server.scanStaff)

    -- ── spectate / follow ──
    function Server.spectate(p)
        Server.spectating = p
        if not p then
            local cam, h = workspace.CurrentCamera, U.hum()
            if cam and h then cam.CameraSubject = h end
        end
    end
    pcall(function()
        RunService:BindToRenderStep("ZenithSpectate", Enum.RenderPriority.Camera.Value - 1, function()
            local p = Server.spectating
            if not p or State.unloaded then return end
            local h = p.Parent and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            local cam = workspace.CurrentCamera
            if h and cam and cam.CameraSubject ~= h then cam.CameraSubject = h end
        end)
    end)

    task.spawn(function()
        while not State.unloaded do
            local p = Server.following
            if p and p.Parent and U.alive() then
                local th = p.Character and U.hrp(p.Character)
                local me = U.hrp()
                if th and me and (th.Position - me.Position).Magnitude > Cfg.followDist + 3 then
                    Move.setNoclip("follow", true)
                    Move.go(function()
                        local t = p.Character and U.hrp(p.Character)
                        return t and (t.CFrame * CFrame.new(0, 0, Cfg.followDist)) or nil
                    end, { stopDist = 2, cancel = function() return Server.following ~= p or State.unloaded end })
                    Move.setNoclip("follow", false)
                end
            end
            task.wait(0.3)
        end
    end)

    -- ── chat ──
    local function logChat(name, text)
        if not Cfg.chatLog or type(text) ~= "string" or text == "" then return end
        local clean = text:gsub("<[^>]+>", "")
        local line = os.date("%H:%M:%S") .. "  " .. tostring(name) .. ": " .. clean
        table.insert(Server.chat, 1, line)
        if #Server.chat > 5 then table.remove(Server.chat) end
        pcall(function()
            if makefolder and not (isfolder and isfolder("Zenith99Nights")) then makefolder("Zenith99Nights") end
            if appendfile and isfile and isfile(CHAT_FILE) then appendfile(CHAT_FILE, line .. "\n")
            elseif writefile then writefile(CHAT_FILE, line .. "\n") end
        end)
    end
    local legacy = TCS.ChatVersion ~= Enum.ChatVersion.TextChatService
    if legacy then
        local function hook(p) track(p.Chatted:Connect(function(msg) logChat(p.Name, msg) end)) end
        for _, p in Players:GetPlayers() do hook(p) end
        track(Players.PlayerAdded:Connect(hook))
    else
        track(TCS.MessageReceived:Connect(function(msg)
            local src = msg.TextSource
            local p = src and Players:GetPlayerByUserId(src.UserId)
            logChat(p and p.Name or "System", msg.Text)
        end))
    end
    function Server.sendChat(text)
        if text == "" then return end
        if legacy then
            local ev = RS:FindFirstChild("DefaultChatSystemChatEvents")
            local say2 = ev and ev:FindFirstChild("SayMessageRequest")
            if say2 then pcall(say2.FireServer, say2, text, "All") end
        else
            local ch = TCS:FindFirstChild("TextChannels")
            local general = ch and ch:FindFirstChild("RBXGeneral")
            if general then pcall(general.SendAsync, general, text) end
        end
    end

    -- ── idle / kick ──
    track(UIS.InputBegan:Connect(function() Server.lastInput = os.clock() end))
    track(GuiService.ErrorMessageChanged:Connect(function()
        local msg = GuiService:GetErrorMessage()
        if msg == "" or Server.leaving or State.unloaded then return end
        if Cfg.webhookOn then task.spawn(Server.webhook, "Disconnected", msg) end
        if not Cfg.autoRejoin then return end
        task.spawn(function()
            task.wait(Cfg.rejoinDelay)
            for _ = 1, 10 do
                queueSelf()
                pcall(TPS.Teleport, TPS, game.PlaceId, LP)
                task.wait(15)
            end
        end)
    end))

    -- ── timed loops: nearby players, server timer, auto chat, webhook ──
    task.spawn(function()
        local inside, timerFired, lastChat, lastHook = {}, false, 0, os.clock()
        while not State.unloaded do
            local me = U.hrp()
            if Cfg.nearAction ~= "Off" and me then
                for _, p in Players:GetPlayers() do
                    if p ~= LP then
                        local th = p.Character and U.hrp(p.Character)
                        local d = th and (th.Position - me.Position).Magnitude
                        if d and d <= Cfg.nearRange then
                            if not inside[p] and not (Cfg.nearIgnoreFriends and isFriend(p)) then
                                inside[p] = true
                                act(Cfg.nearAction, "Player nearby", string.format("%s (%d studs)", p.Name, math.floor(d)))
                            end
                        else
                            inside[p] = nil
                        end
                    end
                end
            else
                table.clear(inside)
            end

            local now = os.clock()
            if Cfg.timerAction ~= "Off" and not timerFired and now - Server.startedAt >= Cfg.timerMin * 60 then
                timerFired = true
                say("Server Timer", Cfg.timerMin .. " minutes are up: " .. Cfg.timerAction, "warn")
                if Server.stopAll and Cfg.timerAction ~= "Rejoin" then pcall(Server.stopAll) end
                if Cfg.timerAction == "Server Hop" then task.spawn(Server.hop)
                elseif Cfg.timerAction == "Rejoin" then task.spawn(Server.rejoin)
                else Server.leave("Server Timer") end
            end
            if Cfg.autoChat and Cfg.autoChatMsg ~= "" and now - lastChat >= Cfg.autoChatSec then
                lastChat = now
                Server.sendChat(Cfg.autoChatMsg)
            end
            if Cfg.webhookOn and now - lastHook >= Cfg.webhookMin * 60 then
                lastHook = now
                task.spawn(Server.webhook, "Status update")
            end
            task.wait(0.5)
        end
    end)

    function Server.shutdown()
        Server.spectate(nil)
        Server.following = nil
        Cfg.autoChat, Cfg.autoRejoin, Cfg.webhookOn, Cfg.nearAction, Cfg.timerAction = false, false, false, "Off", "Off"
        pcall(function() RunService:UnbindFromRenderStep("ZenithSpectate") end)
    end
end

