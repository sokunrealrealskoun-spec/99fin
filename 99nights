            l.TextXAlignment = Enum.TextXAlignment.Left
            l.Font = Enum.Font.Code
            l.TextSize = 12
            l.TextColor3 = lineColor(line)
            l.Text = line
            l.LayoutOrder = n
            l.Parent = sf
            local kids = sf:GetChildren()
            if #kids > 302 then
                for _, k in kids do if k:IsA("TextLabel") then k:Destroy(); break end end
            end
            task.defer(function() sf.CanvasPosition = Vector2.new(0, sf.AbsoluteCanvasSize.Y) end)
        end
        local function button(text, x, cb)
            local b = Instance.new("TextButton")
            b.Size = UDim2.fromOffset(52, 18)
            b.Position = UDim2.new(1, x, 0, 4)
            b.BackgroundColor3 = th.SectionHdr
            b.Text = text
            b.TextColor3 = th.Accent
            b.Font = Enum.Font.GothamSemibold
            b.TextSize = 11
            b.Parent = f
            corner(b, 4)
            b.MouseButton1Click:Connect(cb)
        end
        button("Clear", -116, function()
            table.clear(Meta.logs)
            for _, k in sf:GetChildren() do if k:IsA("TextLabel") then k:Destroy() end end
        end)
        button("Copy", -60, function()
            if setclipboard then pcall(setclipboard, table.concat(Meta.logs, "\n")) end
        end)
        console = { frame = f, add = add }
        for _, line in Meta.logs do add(line) end
    end

    -- ── performance HUD ──
    local hud, hudConn
    function Meta.setHud(on)
        if hud then hud:Destroy(); hud = nil end
        if hudConn then hudConn:Disconnect(); hudConn = nil end
        if not on then return end
        local th = TH
        hud = Instance.new("TextLabel")
        hud.Size = UDim2.fromOffset(190, 92)
        hud.Position = UDim2.new(1, -200, 0, 70)
        hud.BackgroundColor3 = th.BG
        hud.BackgroundTransparency = 0.2
        hud.TextColor3 = th.Text
        hud.Font = Enum.Font.Code
        hud.TextSize = 13
        hud.TextXAlignment = Enum.TextXAlignment.Left
        hud.TextYAlignment = Enum.TextYAlignment.Top
        hud.Text = "…"
        hud.Active = true
        hud.Parent = layer()
        corner(hud, 6)
        local pad = Instance.new("UIPadding"); pad.PaddingLeft = UDim.new(0, 8); pad.PaddingTop = UDim.new(0, 6); pad.Parent = hud
        draggable(hud, hud)
        local frames, acc = 0, 0
        hudConn = RunService.RenderStepped:Connect(function(dt)
            frames += 1
            acc += dt
            if acc < 0.5 then return end
            local fps = math.floor(frames / acc + 0.5)
            frames, acc = 0, 0
            local mem = math.floor(StatsSvc:GetTotalMemoryUsageMb())
            local hrp = U.hrp()
            local p = hrp and hrp.Position
            hud.Text = string.format("FPS      %d\nPing     %d ms\nMemory   %d MB\nPlayers  %d\nPos %s", fps, math.floor(U.ping() * 1000),
                mem, #Players:GetPlayers(), p and string.format("%d, %d, %d", math.floor(p.X), math.floor(p.Y), math.floor(p.Z)) or "—")
        end)
    end

    -- ── music ──
    local music = { idx = 0 }
    function Meta.tracks()
        if music.list then return music.list end
        music.list = {}
        local seen = {}
        local function musical(s)
            local n = (s.Name .. " " .. (s.Parent and s.Parent.Name or "")):lower()
            return n:find("music") or n:find("theme") or n:find("ambien") or n:find("song") or n:find("ost") or s.TimeLength > 40
        end
        for _, root in { RS, game:GetService("SoundService"), workspace } do
            for _, s in root:GetDescendants() do
                if s:IsA("Sound") and s.SoundId ~= "" and s.Name ~= "ZenithMusic" and not seen[s.SoundId] and musical(s) then
                    seen[s.SoundId] = true
                    local where = s.Parent and s.Parent ~= root and (s.Parent.Name .. " · ") or ""
                    music.list[#music.list + 1] = { name = where .. s.Name, id = s.SoundId }
                end
            end
        end
        table.sort(music.list, function(a, b) return a.name < b.name end)
        return music.list
    end
    function Meta.play(id, name)
        if not music.sound then
            music.sound = Instance.new("Sound")
            music.sound.Name = "ZenithMusic"
            music.sound.Parent = SoundService
            track(music.sound.Ended:Connect(function() if not Cfg.musicLoop then Meta.nextTrack() end end))
        end
        music.sound.SoundId = id
        music.sound.Looped = Cfg.musicLoop
        music.sound.Volume = Cfg.musicVolume / 50
        music.sound:Play()
        music.name = name
    end
    function Meta.nextTrack()
        local l = Meta.tracks()
        if #l == 0 then return end
        music.idx = music.idx % #l + 1
        Meta.play(l[music.idx].id, l[music.idx].name)
    end
    function Meta.stopMusic() if music.sound then music.sound:Stop() end; music.name = nil end
    function Meta.setVolume(v) if music.sound then music.sound.Volume = v / 50 end end
    function Meta.setLoop(v) if music.sound then music.sound.Looped = v end end
    function Meta.nowPlaying() return music.name end
    function Meta.toggleGameMusic()
        local found = false
        for _, s in game:GetService("SoundService"):GetDescendants() do
            if s:IsA("Sound") and s.Name ~= "ZenithMusic" and s.TimeLength > 20 then
                found = true
                if s.Playing then s:Pause() else s:Resume() end
            end
        end
        return found
    end

    -- ── emotes (the default character emotes, played on your own animator) ──
    local emoteTrack
    local EMOTES = { Wave = "wave", Point = "point", Dance = "dance", ["Dance 2"] = "dance2", ["Dance 3"] = "dance3", Laugh = "laugh", Cheer = "cheer" }
    local EMOTE_IDS = { wave = 507770239, point = 507770453, dance = 507771019, dance2 = 507776043, dance3 = 507777268, laugh = 507770818, cheer = 507770677 }
    function Meta.emotes()
        local out = {}
        for n in EMOTES do out[#out + 1] = n end
        table.sort(out)
        return out
    end
    function Meta.stopEmote()
        if emoteTrack then pcall(function() emoteTrack:Stop() end); emoteTrack = nil end
    end
    function Meta.emote(name)
        Meta.stopEmote()
        local key = EMOTES[name]
        local hum = U.hum()
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not (key and animator) then return end
        local animate = LP.Character and LP.Character:FindFirstChild("Animate")
        local slot = animate and animate:FindFirstChild(key)
        local clip = slot and slot:FindFirstChildWhichIsA("Animation")
        if not clip then
            clip = Instance.new("Animation")
            clip.AnimationId = "rbxassetid://" .. EMOTE_IDS[key]
        end
        pcall(function()
            emoteTrack = animator:LoadAnimation(clip)
            emoteTrack.Looped = key:find("dance") ~= nil
            emoteTrack:Play()
        end)
    end

    function Meta.shutdown()
        Meta.setHud(false)
        Meta.setConsole(false)
        Meta.stopMusic()
        if music.sound then music.sound:Destroy() end
        if emoteTrack then pcall(function() emoteTrack:Stop() end) end
        if overlay then overlay:Destroy() end
    end
end

